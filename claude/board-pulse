#!/bin/bash
# board-pulse: the daily pre-ops-meeting readout, built only from the repo's own read-only targets.
# The Makefile is the rule. This script adds no rule of its own. It runs the targets from a fresh
# copy of origin/main, keeps their raw output, and pulls out the headline numbers.
#
#   board-pulse                 markdown: headlines, then each target's raw output
#   board-pulse --json          headlines as JSON
#   board-pulse --record ...    also append the headlines to ~/cos/state/board-health.csv (team level only), with the
#                               lane counts the Lanes view shows (cos-flow lanes): one cumulative-flow row a day
#   board-pulse --week ...      the weekly window: make stale DAYS=7, plus make socialize
#                               (stand-ins for the proposed `make week`, per docs/2026-10-29-commands-by-cadence.md)
set -euo pipefail
COS="${COS_HOME:-$HOME/cos}"; REPO="${DATA_ORG_REPO:-$COS/repos/data-org}"   # not ~/Documents: launchd cannot read it (TCC)
MAIN="$COS/data-org-main"; STATE="${COS_STATE:-$COS/state}"
RECORD=0; JSON=0; WEEK=0
for a in "$@"; do case "$a" in --record) RECORD=1 ;; --json) JSON=1 ;; --week) WEEK=1 ;; *) echo "unknown: $a" >&2; exit 64 ;; esac; done

# A detached, read-only copy of origin/main. Never Cassidy's working checkout.
# The same lock as cos-run, so a job's refresh and this one never collide on $MAIN's index.lock. No lock in 5 minutes,
# no readout: it never goes on without the lock.
LOCK="$COS/state/data-org-main.lock"; mkdir -p "$COS/state"; GOT=0
for i in $(seq 1 300); do shlock -f "$LOCK" -p $$ && { GOT=1; break; }; sleep 1; done
[[ $GOT -eq 1 ]] || { echo "data-org-main is busy: pid $(cat "$LOCK" 2>/dev/null) has held $LOCK for 5 minutes. Try again." >&2; exit 75; }
git -C "$REPO" fetch -q origin main
if [[ -d "$MAIN" ]]; then git -C "$MAIN" checkout -q --detach origin/main; else git -C "$REPO" worktree add -q --detach "$MAIN" origin/main; fi
[[ "$(cat "$LOCK" 2>/dev/null)" == "$$" ]] && rm -f "$LOCK"
cd "$MAIN"; SHA="$(git rev-parse --short HEAD)"

# The ops meeting reads stale "since the last business day": on Monday that is Friday.
case "$(date +%u)" in 1) DAYS=3 ;; 7) DAYS=2 ;; *) DAYS=1 ;; esac
[[ $WEEK -eq 1 ]] && DAYS=7

run() { make "$@" 2>&1 || true; }
STALE="$(run stale DAYS=$DAYS)"; WEED="$(run weed)"; RC="$(run roadmap-check)"; SHIP="$(run ship-check)"
SOC=""; [[ $WEEK -eq 1 ]] && SOC="$(run socialize)"

num() { sed -nE "$1" <<<"$2" | head -1; }
STALE_N="$(num 's/^stale .*: ([0-9]+) of ([0-9]+).*/\1/p' "$STALE")";   ACTIVE_N="$(num 's/^stale .*: ([0-9]+) of ([0-9]+).*/\2/p' "$STALE")"
WEED_N="$(num 's/^weed .*: ([0-9]+) of ([0-9]+).*/\1/p' "$WEED")"
GAP_N="$(num 's/^roadmap-check — gap list.*: ([0-9]+) of ([0-9]+).*/\1/p' "$RC")"; GAP_OF="$(num 's/^roadmap-check — gap list.*: ([0-9]+) of ([0-9]+).*/\2/p' "$RC")"
DRIFT_N="$(num 's/^roadmap-check — drift list.*: ([0-9]+).*/\1/p' "$RC")"
NORAGB_N="$(grep -cE '^ +#[0-9]+ .* · · ' <<<"$SHIP" || true)"
UNTOUCHED_N="$(grep -cE '![0-9]+d untouched' <<<"$SHIP" || true)"

H="$(jq -n --arg asof "$(date -u +%FT%TZ)" --arg sha "$SHA" --argjson days "$DAYS" \
  --arg stale "${STALE_N:-}" --arg active "${ACTIVE_N:-}" --arg weed "${WEED_N:-}" --arg gap "${GAP_N:-}" --arg gapof "${GAP_OF:-}" \
  --arg drift "${DRIFT_N:-}" --arg noragb "${NORAGB_N:-}" --arg untouched "${UNTOUCHED_N:-}" '
  def n: if . == "" then null else tonumber end;
  {as_of: $asof, main: $sha, stale_days: $days,
   stale: ($stale|n), active: ($active|n), weed: ($weed|n),
   roadmap_gaps: ($gap|n), roadmap_gaps_of: ($gapof|n), roadmap_drift: ($drift|n),
   shipping_no_ragb: ($noragb|n), shipping_untouched: ($untouched|n)}')"

# Lane counts as the Lanes view shows them (every item that isn't archived, by Status) and the open cards in No Status,
# from cos-flow (read-only). A failed read leaves the lane cells blank; it never stops the pulse.
FLOW="${COS_FLOW:-$COS/bin/cos-flow}"
LJ="$("$FLOW" lanes --json 2>/dev/null || true)"; NJ="$("$FLOW" nostatus --json 2>/dev/null || true)"
jq -e . >/dev/null 2>&1 <<<"$LJ" || LJ='{}'; jq -e . >/dev/null 2>&1 <<<"$NJ" || NJ='{}'
H="$(jq --argjson l "$LJ" --argjson n "$NJ" '. + {lanes: ($l.view // null), lanes_open: ($l.open // null), no_status_open: (($n.open // null) | if . == null then null else length end), no_status_cards: ($n.open // [])}' <<<"$H")"
COLS="as_of,main,stale_days,stale,active,weed,roadmap_gaps,roadmap_gaps_of,roadmap_drift,shipping_no_ragb,shipping_untouched,lanes_intake,lanes_discovery,lanes_defining,lanes_shipping,lanes_completed_no_delivery,lanes_delivery_prep,lanes_delivered,lanes_dropped,lanes_no_status,no_status_open"
if [[ $RECORD -eq 1 ]]; then
  mkdir -p "$STATE"; F="$STATE/board-health.csv"
  [[ -f "$F" ]] || echo "$COLS" > "$F"
  # A file from before the lane columns: widen the header in place. Old rows keep blank lane cells (no backfill).
  if [[ "$(head -1 "$F")" != "$COLS" ]]; then
    old_n="$(head -1 "$F" | awk -F, '{print NF}')"; new_n="$(awk -F, '{print NF}' <<<"$COLS")"
    if [[ "$COLS" == "$(head -1 "$F"),"* ]]; then
      pad="$(printf '%*s' $((new_n - old_n)) '' | tr ' ' ',')"
      { echo "$COLS"; tail -n +2 "$F" | sed "s/\$/$pad/"; } > "$F.new" && mv "$F.new" "$F"
    fi
  fi
  jq -r '[.as_of,.main,.stale_days,.stale,.active,.weed,.roadmap_gaps,.roadmap_gaps_of,.roadmap_drift,.shipping_no_ragb,.shipping_untouched,
          .lanes.Intake,.lanes.Discovery,.lanes.Defining,.lanes.Shipping,.lanes["Completed No Delivery"],.lanes["Delivery Prep"],.lanes.Delivered,.lanes.Dropped,.lanes["No Status"],.no_status_open]|@csv' <<<"$H" >> "$F"
fi

if [[ $JSON -eq 1 ]]; then echo "$H"; exit 0; fi

jq -r '"# Board pulse, \(.as_of) (origin/main \(.main))",
  "",
  "- Stale, no comment or PR event in \(.stale_days) day(s): \(.stale) of \(.active) active cards",
  "- Weed candidates, no owner or silent 14 days: \(.weed)",
  "- Roadmap gaps, missing Pillar metric or Target: \(.roadmap_gaps) of \(.roadmap_gaps_of). Drift, Target differs from milestone: \(.roadmap_drift)",
  "- Shipping and Delivery Prep: \(.shipping_no_ragb) with no RAGB, \(.shipping_untouched) flagged untouched",
  (if .lanes then "- Lanes view: " + ([.lanes | to_entries[] | "\(.key) \(.value)"] | join(", ")) else "- Lanes view: not read (cos-flow lanes failed)" end),
  (if .no_status_open == null then "- No Status: not read" elif .no_status_open == 0 then "- No Status: no open card" else
   "- No Status, open cards for their owners to place in a lane: " + ([.no_status_cards[] | "\(.card) (\(.owner))"] | join(", ")) end)' <<<"$H"
printf '\n## make stale DAYS=%s\n```\n%s\n```\n\n## make ship-check\n```\n%s\n```\n\n## make roadmap-check\n```\n%s\n```\n\n## make weed\n```\n%s\n```\n' "$DAYS" "$STALE" "$SHIP" "$RC" "$WEED"
[[ -n "$SOC" ]] && printf '\n## make socialize\n```\n%s\n```\n' "$SOC"
exit 0
