#!/bin/bash
# cos-sandbox-test <fix worktree>: run that copy's installer and every test in a throwaway home, under a macOS
# sandbox that lets it write only inside its own temp folder and reach only this Mac. A fix job may edit install.sh,
# so this wrapper (installed, not editable by a job) is what keeps an edited installer away from the live system.
# Prints the log path and the "Result:" line; exits with the installer's code.
set -uo pipefail
WT="${1:?usage: cos-sandbox-test <worktree under ~/cos/fixes>}"
WT="$(cd "$WT" 2>/dev/null && pwd -P)" || { echo "no such folder" >&2; exit 64; }
FIXES="$(cd "$HOME/cos/fixes" 2>/dev/null && pwd -P)" || { echo "no ~/cos/fixes" >&2; exit 64; }
[[ "$WT" == "$FIXES/"* && -f "$WT/install.sh" ]] || { echo "refusing: only a fix worktree under ~/cos/fixes" >&2; exit 64; }
T="$(mktemp -d)"; T="$(cd "$T" && pwd -P)"; LOG="$T/sandbox.log"
cat > "$T/profile.sb" <<SB
(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "$T") (subpath "/private/tmp") (subpath "/private/var/folders") (subpath "/dev"))
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*") (remote unix-socket))
SB
mkdir -p "$T/home"
env -i PATH="$T/home/cos/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin" \
  HOME="$T/home" USER="${USER:-}" LOGNAME="${LOGNAME:-}" SHELL=/bin/bash TMPDIR="$T/" \
  sandbox-exec -f "$T/profile.sb" /bin/bash "$WT/install.sh" --sandbox > "$LOG" 2>&1
rc=$?
echo "log: $LOG"
grep -E '^Result:' "$LOG" || echo "Result: no result line (the installer crashed; see the log)"
grep -E '✗' "$LOG" | head -20
exit $rc
