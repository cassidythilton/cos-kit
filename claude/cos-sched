#!/bin/bash
# cos-sched: the Mac's own clock. launchd calls it; no bot starts these jobs.
#
#   cos-sched <slot>            run one scheduled job, then push its receipt to the owning bot's routine webhook
#   cos-sched <slot> --dry-run  print what would run and where it would go
#   cos-sched list              the schedule
#
# Why: a Grok routine runs in the cloud, and asking the Mac to run a command needs a tap on an approval card. A routine
# can't wait for that. So the Mac runs its own schedule and hands the result to the bot, which reports or stays quiet.
# The bot never runs a command here on a schedule. Interactive work (Cassidy in a chat) still goes bot -> cos-run.
set -uo pipefail
# launchd starts jobs with a bare PATH. Name every tool's home, so claude, agent, gh and uv are found.
export PATH="$HOME/cos/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH:/usr/bin:/bin:/usr/sbin:/sbin"
HERE="$(cd "$(dirname "$0")" && pwd)"
# launchd's working directory may be one macOS won't let a job read (git: "Unable to read current working directory").
cd "$HOME" || exit 1
COS="$HOME/cos"; BRIEFS="$COS/claude/briefs"; LOG="$COS/state/sched.log"; mkdir -p "$COS/state"
SLOT="${1:?slot or list}"; DRY=0; [[ "${2:-}" == "--dry-run" ]] && DRY=1
D="$(date +%Y%m%d)"

# slot | when (launchd: weekday numbers, 1 = Monday, then HH:MM) | allowed hours (skip if the Mac woke too late) | bot | lane
TABLE='followups   | 1-5 06:15 | 5-9   | ops     | investigate
pulse       | 1-5 08:10 | 7-11  | steward | quick
reconcile   | 2,4 10:00 | 9-14  | steward | investigate
capture     | 1-5 16:00 | 15-21 | steward | investigate
week        | 5 10:00   | 9-15  | steward | investigate
opportunity | 1 08:30   | 7-13  | builder | investigate
keeper      | 5 13:00   | 12-18 | keeper  | investigate
obligations | 1-5 08:00,10:00,12:00,14:00,16:00 | 7-17 | ops | script'

if [[ "$SLOT" == list ]]; then echo "$TABLE"; exit 0; fi
row="$(printf '%s\n' "$TABLE" | awk -F'|' -v s="$SLOT" '{k=$1; gsub(/ /,"",k)} k==s')"
[[ -n "$row" ]] || { echo "unknown slot: $SLOT (cos-sched list)" >&2; exit 64; }
HOURS="$(echo "$row" | cut -d'|' -f3 | tr -d ' ')"; BOT="$(echo "$row" | cut -d'|' -f4 | tr -d ' ')"; LANE="$(echo "$row" | cut -d'|' -f5 | tr -d ' ')"
JOB="$SLOT-$D"

log() {
  printf '%s %s %s\n' "$(date +%FT%T)" "$SLOT" "$*" >> "$LOG"
  "$HOME/cos/bin/cos-ledger" schedule slot="$SLOT" msg="$*" >/dev/null 2>&1 || true
}

# Paused by `cos-run pause <slot|all> <days>`: skip silently until the date passes.
TODAY="$(date +%F)"
for pf in "$COS/state/pause-$SLOT" "$COS/state/pause-all"; do
  if [[ -f "$pf" ]]; then u="$(cat "$pf")"; if [[ "$TODAY" < "$u" || "$TODAY" == "$u" ]]; then [[ $DRY -eq 1 ]] && { echo "paused through $u"; exit 0; }; log "paused through $u"; exit 0; else rm -f "$pf"; fi; fi
done

# The Mac was asleep at the scheduled time and launchd is catching up. A morning brief at 9 pm is worse than none,
# so skip and tell the bot the run was missed (silence would read as "nothing changed").
h=$((10#$(date +%H))); lo="${HOURS%-*}"; hi="${HOURS#*-}"
if (( h < lo || h > hi )); then
  [[ $DRY -eq 1 ]] && { echo "would skip (outside hours $HOURS) and tell $BOT"; exit 0; }   # a dry run records nothing
  log "skipped: outside $HOURS"
  printf '{"receipt":{"status":"blocked","summary":"MISSED: the Mac was asleep or offline at the scheduled time. No fresh data. Do not reuse old results."},"job":"%s"}\n' "$JOB" > "$COS/state/missed-$SLOT.json"
  cos-push "$BOT" "$SLOT" "$COS/state/missed-$SLOT.json"; exit 0
fi

if [[ $DRY -eq 1 ]]; then
  if [[ "$LANE" == script ]]; then echo "cos-obligations --act  -> $BOT"
  elif [[ "$LANE" == quick ]]; then echo "cos-run quick $JOB <pulse question> --with 'board-pulse --record'  -> $BOT"
  else [[ "$SLOT" == capture || "$SLOT" == week ]] && echo "cos-flow brief $SLOT $COS/outbox/$JOB  (board facts the brief reads, read-only)"
       echo "cos-run $LANE $JOB $BRIEFS/$SLOT.md  -> $BOT"; [[ -f "$BRIEFS/$SLOT.md" ]] || echo "MISSING brief: $BRIEFS/$SLOT.md"; fi
  exit 0
fi

log "start $JOB"
export COS_ROUTINE="sched-$SLOT"
# Every run leaves a receipt in its job folder, where cos-run receipt looks. A job that dies before writing one gets a
# failed receipt carrying its exit code and stderr (kept in sched.err). An earlier run's receipt is set aside first,
# so a crash can't pass it off as this run's result.
OUTD="$COS/outbox/$JOB"; R="$OUTD/receipt.json"; ERR="$OUTD/sched.err"; rc=0
mkdir -p "$OUTD"; [[ -f "$R" ]] && mv "$R" "$OUTD/receipt.prev.json"
# Capture and week read board facts from cos-flow (no model, read-only): lane counts, the week's lane moves, evidence
# lines for owners, No Status cards, and the DRD/DADR check on cards worked today. Staged before the job starts so the
# job reads facts instead of re-deriving them. If the read fails, the file says so and the job must say so too.
if [[ "$SLOT" == capture || "$SLOT" == week ]]; then
  "$HOME/cos/bin/cos-flow" brief "$SLOT" "$OUTD" >/dev/null 2>"$OUTD/flow.err" \
    || printf '# Board facts NOT read\n\ncos-flow failed (%s). Say so in the summary; do not infer lane counts, moves or DRD facts.\n' \
         "$(tail -c 200 "$OUTD/flow.err" | tr '\n' ' ')" > "$OUTD/flow-$SLOT.md"
fi
if [[ "$LANE" == script ]]; then
  COS_CALLER=sched cos-obligations --act >/dev/null 2>"$ERR" || rc=$?
elif [[ "$LANE" == quick ]]; then
  COS_CALLER=sched cos-run quick "$JOB" "Summarize this morning's board pulse for Cassidy in three lines: the headline numbers vs yesterday, the cards most at risk (Shipping with no RAGB or untouched, RED with no fresh log), how many owners need a nudge, and each open card in No Status with its owner (they place it in a lane; never a bot on another owner's card). If nothing changed since yesterday's row in board-health, answer exactly: NO CHANGE" \
    --with "board-pulse --record" >/dev/null 2>"$ERR" || rc=$?
else
  COS_CALLER=sched cos-run "$LANE" "$JOB" "$BRIEFS/$SLOT.md" >/dev/null 2>"$ERR" || rc=$?
fi
# The error leaves the Mac in the receipt. It goes through the ledger's own redaction (cos-ledger, written to a scratch
# ledger and read back), then loses what the ledger doesn't cut: other gh*_ tokens, any-case Bearer, URL credentials and
# query strings. If the redaction can't run, the error is withheld.
scrub() {
  local d; d="$(mktemp -d)" || { echo "(withheld: redaction failed)"; return; }
  COS_LEDGER_DIR="$d" "$HERE/cos-ledger" scrub msg="$1"
  jq -r '.msg // "(withheld: redaction failed)"' "$d/scrub.jsonl" 2>/dev/null || echo "(withheld: redaction failed)"
  rm -rf "$d"
}
E="$(scrub "$(tail -c 400 "$ERR" 2>/dev/null | tr '\n\r\t' '   ')" | sed -E -e 's/gh[pousr]_[A-Za-z0-9_]+/<redacted>/g' \
  -e 's/[Bb][Ee][Aa][Rr][Ee][Rr][[:space:]]+[^[:space:]]+/Bearer <redacted>/g' \
  -e 's#(https?://)[^[:space:]/@]*@#\1#g' -e 's#(https?://[^[:space:]?]*)\?[^[:space:]]*#\1#g')"
(( rc == 0 )) || log "$JOB failed (exit $rc): ${E:0:200}"
[[ -f "$R" ]] || jq -n --arg j "$JOB" --arg s "FAILED: $JOB stopped (exit $rc) before writing a receipt. Error: ${E:-nothing on stderr}. Full log: $ERR" \
  '{receipt: {status: "failed", summary: $s}, lane: "sched", job: $j}' > "$R"

# Silent when nothing changed: don't spend a bot turn on it.
if jq -e '(.receipt.summary // "") | test("^\\s*NO CHANGE")' "$R" >/dev/null 2>&1; then log "no change; not pushed"; exit 0; fi
cos-push "$BOT" "$SLOT" "$R" && log "pushed to $BOT" || log "push to $BOT failed"
