def handoff_entries(text):
    """Split a pasted block into commands: comments and blanks go, backslash lines join, a heredoc stays with its command."""
    lines, out, i = text.splitlines(), [], 0
    while i < len(lines):
        ln = lines[i].rstrip()
        while ln.endswith("\\") and i + 1 < len(lines):
            i += 1; ln = ln[:-1] + " " + lines[i].strip()
        body = None
        m = re.search(r"<<-?\s*['\"]?(\w+)['\"]?", ln)
        if m:
            term, buf = m.group(1), []
            i += 1
            while i < len(lines) and lines[i].strip() != term:
                buf.append(lines[i]); i += 1
            body = "\n".join(buf)
            i += 1
            if i < len(lines) and lines[i].strip() in (")\"", ")'", ")"):
                i += 1  # the close of "$(cat <<'EOF' ... EOF )"
        else:
            i += 1
        st = ln.strip()
        if st and not st.startswith("#"):
            out.append((st, body))
    return out


def kv(argv):
    return {a.split("=", 1)[0]: a.split("=", 1)[1] for a in argv if "=" in a and re.match(r"^[A-Z_]+=", a)}


def handoff_plan(line, body, job, opts):
    """One handoff line -> ("run", action, args, extra opts) | ("refuse", tier, why) | ("skip", why)."""
    if line.startswith("DRY_RUN=1 "):
        return ("skip", "a preview; cos-run gh previews each write itself")
    if re.search(r"status:\s*(Approved|accepted)|TO=Approved", line, re.I):
        return ("refuse", "never", "flipping a status to Approved or accepted: no job does that; the CDO ratifies")
    head = line.split("<<")[0]
    if body is None and re.search(r"(;|&&|\|\||\||`|\$\(|>)", line):
        return ("refuse", 2, "more than one command, or a shell expansion: show Cassidy the line itself")
    import shlex
    try:
        argv = shlex.split(head.replace('"$(cat', "").replace("$(cat", ""))
    except ValueError:
        return ("refuse", 2, "a line that doesn't parse: show Cassidy the line itself")
    if not argv:
        return ("skip", "empty")
    if argv[0] == "git":
        return ("refuse", 0, "git works on the files in the checkout where Cowork wrote them, which jobs on this Mac can't see. "
                             "Run it there, or ask the Chief for a draft job (cos-run draft --doc) and push that")
    if argv[0] == "make":
        t = argv[1] if len(argv) > 1 else ""
        a = kv(argv[2:]); repo = a.get("IN", "data-org")
        if t in ("next-id", "doctor", "board", "gate", "stale", "socialize", "raqs", "roadmap-check", "ship-check", "lint-writing"):
            return ("skip", f"make {t} is read-only; cos-run gh re-checks IDs and cards before each write")
        if t == "set-pillar" and a.get("CARD") and a.get("TO"):
            return ("run", "lane", [f"{repo}#{a['CARD']}", a["TO"]], {})
        if t == "field" and a.get("CARD") and a.get("FIELD") and a.get("TO"):
            return ("run", "field", [f"{repo}#{a['CARD']}", a["FIELD"], a["TO"]], {})
        if t == "board-add" and a.get("URL"):
            m = re.match(r"^https://github\.com/wisecodeai/([A-Za-z0-9._-]+)/(issues|pull)/(\d+)$", a["URL"])
            if not m:
                return ("refuse", 2, "board-add of something outside wisecodeai")
            return ("run", "board-add", [f"{m.group(1)}#{m.group(3)}"] + ([a["PILLAR"]] if a.get("PILLAR") else []), {})
        tiers = {"complete": (1, "make complete"), "ragb": (1, "RAGB"), "ship-link": (1, "make ship-link (files and boards an effort)"),
                 "context-request": (1, "a context request to the CDO"), "promote": (2, "make promote (it closes the issue)"),
                 "intake": (0, "make intake isn't in the tier-0 list; a card he dictated is filed with cos-run gh create, from a body file"),
                 "scaffold": (0, "make scaffold writes a doc file in a checkout; ask the Chief for a draft job (cos-run draft --doc)")}
        if t in tiers:
            return ("refuse",) + tiers[t]
        return ("refuse", 2, f"make {t} isn't a target cos-run knows")
    if argv[0] == "gh" and len(argv) > 2:
        sub = f"{argv[1]} {argv[2]}"
        def repo_of():
            if "--repo" in argv and argv.index("--repo") + 1 < len(argv):
                r = argv[argv.index("--repo") + 1]
                return r.split("/", 1)[1] if r.startswith("wisecodeai/") else None
            return "data-org"
        if sub == "issue edit" and len(argv) > 3 and argv[3].isdigit():
            r = repo_of()
            if not r:
                return ("refuse", 2, "an edit outside wisecodeai")
            acts, k = [], 4
            while k < len(argv):
                f = argv[k]
                if f == "--repo":
                    k += 2; continue
                if f in ("--add-label", "--remove-label", "--add-assignee", "--remove-assignee", "--milestone", "--remove-milestone"):
                    if f == "--remove-milestone":
                        acts.append(("milestone", [f"{r}#{argv[3]}", "none"])); k += 1; continue
                    if k + 1 >= len(argv):
                        return ("refuse", 2, f"{f} with no value")
                    v = argv[k + 1]
                    if f == "--milestone":
                        acts.append(("milestone", [f"{r}#{argv[3]}", v]))
                    else:
                        verb, what = f[2:].split("-", 1)
                        for one in v.split(","):
                            acts.append((what, [f"{r}#{argv[3]}", verb, one]))
                    k += 2; continue
                if f in ("--body", "--body-file", "--title"):
                    return ("refuse", 2, "an issue body or title edit")
                return ("refuse", 2, f"gh issue edit {f} isn't a tier-0 edit")
            return ("multi", acts)
        if sub == "pr create":
            if "--draft" not in argv:
                return ("refuse", 1, "opening a ready PR can request reviews, which notifies people. As --draft from a cassidy/ branch it's tier 0")
            hd = argv[argv.index("--head") + 1] if "--head" in argv and argv.index("--head") + 1 < len(argv) else ""
            ti = argv[argv.index("--title") + 1] if "--title" in argv and argv.index("--title") + 1 < len(argv) else ""
            if not hd or not ti:
                return ("refuse", 0, "a draft PR needs --head <cassidy/branch> and --title; the line names neither the branch nor both")
            r = repo_of() or ""
            if not r:
                return ("refuse", 2, "a PR outside wisecodeai")
            bf = argv[argv.index("--body-file") + 1] if "--body-file" in argv and argv.index("--body-file") + 1 < len(argv) else ""
            if body is not None:
                d = f"{COS}/outbox/{job}"; os.makedirs(d, exist_ok=True)
                bf = f"{d}/pr-body-{secrets.token_hex(3)}.md"
                open(bf, "w").write(body + "\n")
            if not bf:
                return ("refuse", 0, "a draft PR needs its body as a file in the job folder (--body-file) or a heredoc")
            return ("run", "draft-pr", [r, hd], {"title": ti, "body-file": bf})
        tiers = {"issue comment": (1, "a comment"), "pr comment": (1, "a PR comment"), "pr ready": (1, "marking a PR ready"),
                 "pr merge": (2, "a merge"), "issue close": (2, "a close"), "pr close": (2, "a close"), "issue create": (0, "a new card: cos-run gh create, with --evidence for when he dictated it"),
                 "issue delete": (2, "a delete"), "issue reopen": (2, "a reopen")}
        if sub == "pr review":
            return ("refuse", 2 if "--approve" in argv or "--request-changes" in argv else 1, "a PR review")
        if sub == "pr edit":
            return ("refuse", 1 if "--add-reviewer" in argv else 2, "requesting a review" if "--add-reviewer" in argv else "a PR edit")
        if sub in tiers:
            return ("refuse",) + tiers[sub]
    return ("refuse", 2, "not a command cos-run knows; show Cassidy the line itself")


def handoff(job, src, opts):
    """A Cowork handoff block, pasted to the Chief: run the tier-0 lines, refuse the rest with their tier."""
    if src == "-":
        text = sys.stdin.read()
    else:
        real = os.path.realpath(os.path.expanduser(src or ""))
        if not real.startswith(os.path.realpath(f"{COS}/outbox") + "/") or not os.path.isfile(real):
            raise Refuse("handoff reads the block from a file in ~/cos/outbox/<job>/ or from stdin (-).", code=64)
        text = open(real).read()
    d = f"{COS}/outbox/{job}"
    os.makedirs(d, exist_ok=True)
    if os.path.exists(f"{d}/receipt.json"):
        raise Refuse(f"job {job} already ran. Use a new job id.", code=64)
    open(f"{d}/handoff.sh", "w").write(text)
    results, k = [], 0
    for line, body in handoff_entries(text):
        pl = handoff_plan(line, body, job, opts)
        items = [("run", a, g, {}) for a, g in pl[1]] if pl[0] == "multi" else [pl]
        for it in items:
            if it[0] == "skip":
                results.append({"line": line, "result": "skipped", "why": it[1]}); continue
            if it[0] == "refuse":
                tier, why = it[1], it[2]
                ledger(job=job, action=("handoff: " + line)[:300], decision="refused", tier=str(tier), why=why)
                results.append({"line": line, "result": "refused", "tier": tier, "why": why}); continue
            k += 1
            sub = f"{job[:56]}-{k}"
            o = {"label": [], **{x: opts[x] for x in ("evidence", "dry-run") if opts.get(x)}, **it[3]}
            try:
                buf = __import__("io").StringIO(); real_out = sys.stdout; sys.stdout = buf
                try:
                    do(sub, it[1], it[2], o)
                finally:
                    sys.stdout = real_out
                r = json.load(open(f"{COS}/outbox/{sub}/receipt.json")) if not o.get("dry-run") else json.loads(buf.getvalue() or "{}")
                results.append({"line": line, "result": "dry-run" if o.get("dry-run") else "ran", "tier": 0, "job": sub,
                                "says": (r.get("receipt") or {}).get("summary", ""), "verdict": (r.get("receipt") or {}).get("verdict", "")})
            except Refuse as e:
                if e.tier is not None:
                    ledger(job=sub, action=("handoff: " + line)[:300], decision="refused", tier=str(e.tier), why=str(e))
                results.append({"line": line, "result": "refused", "tier": e.tier if e.tier is not None else "-", "why": str(e)})
    ran = [r for r in results if r["result"] in ("ran", "dry-run")]
    ref = [r for r in results if r["result"] == "refused"]
    by_tier = {}
    for r in ref:
        by_tier[str(r["tier"])] = by_tier.get(str(r["tier"]), 0) + 1
    summary = (f"Handoff: {len(ran)} tier-0 line(s) {'previewed' if opts.get('dry-run') else 'done'}, {len(ref)} refused"
               + (" (" + ", ".join(f"tier {t}: {n}" for t, n in sorted(by_tier.items())) + ")" if ref else "")
               + f", {sum(1 for r in results if r['result'] == 'skipped')} skipped. Refused lines go to Cassidy by tier: tier 1 is one yes, "
               "tier 2 always asks, 'never' is never.")
    rec = {"job": job, "lane": "gh", "receipt": {"status": "done", "summary": summary}, "handoff": results}
    if not opts.get("dry-run"):
        receipt(job, rec)
    else:
        out(rec)
    return 0


def rows():
    try:
        with open(f"{LEDGER_DIR}/tier_zero.jsonl") as f:
            return [json.loads(l) for l in f if l.strip()]
    except FileNotFoundError:
        return []


def undo(job, ref):
    r = [x for x in rows() if x.get("ref") == ref and x.get("decision") == "done"]
    if not r:
        raise Refuse(f"no done tier-0 row {ref} in the ledger. See: cos-run gh <job> today", code=66)
    r = r[-1]
    if any(x.get("ref") == ref and x.get("decision") == "undone" for x in rows()):
        raise Refuse(f"{ref} was already undone.", code=68)
    argv = json.loads(r.get("undo_argv") or "null")
    if not argv:
        raise Refuse(f"{ref} has no automatic undo ({r.get('undo', '')}).", code=65)
    if argv[0] not in ("gh", "make") or (argv[0] == "gh" and argv[1:3] not in (["issue", "edit"], ["pr", "edit"], ["project", "item-edit"], ["project", "item-delete"], ["api", "graphql"])):
        raise Refuse("the recorded undo isn't one tier 0 can run.", code=65)
    who = run(["gh", "api", "user", "--jq", ".login"]).stdout.strip()
    if who != ME:
        raise Refuse(f"gh is signed in as '{who}', not {ME}. Nothing ran.", code=77)
    # Rebuild the decision from the row to know what "unchanged since" means, by re-reading the card.
    p = replan_for_undo(r)
    c = card(r["card"])
    if not p["still"](c):
        raise Refuse(f"{r['card']} changed since {ref} (it no longer reads '{r['new']}'). Nothing undone; someone else may own that change now.", code=65)
    if argv[0] == "make":
        make(argv[1:])
    else:
        run(argv)
    c2 = card(r["card"])
    ok = p["back"](c2)
    verdict = "VERIFIED" if ok else "NOT VERIFIED"
    row = dict(job=job, ref=ref, action="undo " + r["action"], card=r["card"], old=r["new"], new=r["old"], decision="undone", verdict=verdict)
    ledger(**row)
    rec = {"job": job, "lane": "gh", "receipt": {"status": "done" if ok else "partial", "verdict": verdict,
           "summary": f"Undid {ref} on {r['card']}: back to '{r['old']}'." + ("" if ok else " Read back does NOT match; check the card.")}, "tier0": row}
    receipt(job, rec)
    return 0 if ok else 1


def replan_for_undo(r):
    act = r["action"].split()
    a = act[0]
    if a in ("label", "assignee"):
        key = "labels" if a == "label" else "assignees"
        val = " ".join(act[3:])
        added = act[2] == "add"
        return {"still": lambda c: (val in c[key]) == added, "back": lambda c: (val in c[key]) != added}
    if a == "milestone":
        return {"still": lambda c: c["milestone"] == r["new"], "back": lambda c: c["milestone"] == r["old"]}
    if a == "field":
        m = re.match(r'field \S+ (Pillar metric|Theme|Horizon|Target) ', r["action"])
        f = m.group(1) if m else ""
        return {"still": lambda c: c["fields"].get(f, "") == r["new"], "back": lambda c: c["fields"].get(f, "") == r["old"]}
    if a == "lane":
        return {"still": lambda c: c["fields"].get("Status", "") == r["new"], "back": lambda c: c["fields"].get("Status", "") == r["old"]}
    if a == "board-add":
        lane = r["new"].replace("on the board, ", "")
        return {"still": lambda c: bool(c["item"]) and c["fields"].get("Status") == lane,
                "back": lambda c: (not c["item"]) if r["old"] == "not on the board" else c["fields"].get("Status", "") == r["old"].replace("on the board, ", "")}
    if a == "link":
        kind, other = act[1], act[3]
        listing = "subs" if kind == "sub" else "blocked_by"
        orepo, on = ref_parts(other)
        o = f"{orepo}#{on}"
        return {"still": lambda c: o in c[listing], "back": lambda c: o not in c[listing]}
    raise Refuse(f"{a} has no automatic undo.", code=65)


def today():
    now = dt.datetime.now().astimezone()
    lines, refused = [], 0
    undone = {x.get("ref") for x in rows() if x.get("decision") == "undone"}
    for x in rows():
        try:
            t = dt.datetime.fromisoformat(x["ts"].replace("Z", "+00:00")).astimezone()
        except Exception:
            continue
        if t.date() != now.date():
            continue
        if x.get("decision") == "refused":
            refused += 1; continue
        if x.get("decision") not in ("done", "undone"):
            continue
        verb = "Undid" if x["decision"] == "undone" else "Did"
        tail = f" Undo: cos-run gh <job> undo {x['ref']}" if x["decision"] == "done" and x.get("undo_argv") and x.get("ref") not in undone else ""
        why = f" Why: {x['evidence']}." if x.get("evidence") else ""
        lines.append(f"- {t:%H:%M} {verb}: {x['action']} on {x['card']} ({x.get('old') or 'blank'} -> {x.get('new') or 'blank'}). {x.get('verdict', '')}.{why}{tail}")
    head = f"Done without asking today ({len(lines)})" + (f"; {refused} refused and left for Cassidy" if refused else "")
    print(head + (":" if lines else ": nothing."))
    print("\n".join(lines))
    return 0


