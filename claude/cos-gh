def plain(path):
    try:
        lines = [l.strip() for l in open(os.path.expanduser(path)) if l.strip() and not l.strip().startswith("#")]
    except FileNotFoundError:
        raise Refuse(f"no batch at {path}", code=66)
    items, top = [], 0
    for l in lines:
        for rx, tier, fmt in PLAIN:
            m = re.match(rx, l)
            if m:
                g = [s.strip('"') for s in m.groups()]
                says = re.sub(r"@(\d+)", lambda m: "the new card" if m.group(1) == "1" else f"new card {m.group(1)}", fmt.format(*g).replace(" --", " ").rstrip(":"))
                items.append({"tier": tier, "says": says}); top = max(top, tier); break
        else:
            items.append({"tier": 2, "says": "Unrecognized line; show Cassidy the line itself: " + l}); top = 2
    out({"batch": path, "writes": len(items), "highest_tier": top, "items": items,
         "ask": "One yes covers all of it." if top <= 1 else "Includes tier 2: show Cassidy each tier-2 line and wait for his yes to those lines."})
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help") or "--help" in argv or "-h" in argv:
        print(HELP); return 0
    job = argv[0]
    if not JOB_RE.match(job):
        raise Refuse(f"bad job id '{job}': lowercase letters, digits, dot, dash or underscore, up to 61 characters. Example: cos-run gh t0-712-label label data-org#712 add type/discovery", code=64)
    if len(argv) < 2:
        raise Refuse("missing the action. Run: cos-run gh --help", code=64)
    action, rest = argv[1], argv[2:]
    args, opts = [], {"label": []}
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--dry-run":
            opts["dry-run"] = True; i += 1
        elif a in ("--evidence", "--title", "--body-file", "--milestone", "--row", "--parent", "--label"):
            if i + 1 >= len(rest):
                raise Refuse(f"{a} needs a value. Run: cos-run gh --help", code=64)
            if a == "--label":
                opts["label"].append(rest[i + 1])
            else:
                opts[a[2:]] = rest[i + 1]
            i += 2
        elif a.startswith("--"):
            raise Refuse(f"unknown option {a}. Run: cos-run gh --help", code=64)
        else:
            args.append(a); i += 1
    if action == "today":
        return today()
    if action == "plain":
        return plain(args[0] if args else "")
    if action == "undo":
        if not args:
            raise Refuse(f"which row? cos-run gh {job} undo <ref>   (refs are in: cos-run gh {job} today)", code=64)
        return undo(job, args[0])
    return do(job, action, args, opts)


if __name__ == "__main__":
    a = sys.argv[1:]
    job = a[0] if a and JOB_RE.match(a[0]) else ""
    try:
        sys.exit(main(a))
    except Refuse as e:
        if e.tier is not None:
            ledger(job=job, action=" ".join(a[1:])[:300], decision="refused", tier=str(e.tier), why=str(e))
        tier = f" (tier {e.tier})" if e.tier is not None else ""
        print(f"cos-run gh refused{tier}: {e}", file=sys.stderr)
        sys.exit(e.code)
