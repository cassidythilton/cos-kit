#!/usr/bin/env -S python3 -I
"""cos-gh: the tier-0 GitHub lane (cos-run gh). Small writes Cassidy approved once, in advance (plan 2026-11-14,
item 1), done without asking and recorded so each can be undone.

Every write: re-read the live card, check it is his (or, for another owner's card, that the field is blank and the value
comes from the card's Data Roadmap row), preview it, run it through data-org's own interface (make targets; gh issue
edit for labels, assignees and milestones; cos-link for links), read it back, and write one ledger row: what, why
(evidence), old value, new value, the undo command and the verdict. Anything else is refused, naming its tier.
No model runs here. Run cos-run gh --help for the calls.
"""
import datetime as dt
import json
import os
import re
import secrets
import subprocess
import sys

HOME = os.path.expanduser("~")
COS = f"{HOME}/cos"
MAIN = f"{COS}/data-org-main"
LEDGER_DIR = os.environ.get("COS_LEDGER_DIR", f"{COS}/state/ledger")
ME = "cassidythilton"
ORG = "wisecodeai"
PROJECT = 1
FIELDS = ("Pillar metric", "Theme", "Horizon", "Target")
SHEET_COL = {"Pillar metric": "I", "Theme": "C", "Horizon": "E"}  # Target is never copied from the row (roadmap skill)
LANES = ("Intake", "Discovery", "Defining", "Shipping", "Delivery Prep")  # tier 0 moves; finishes and drops are not
JOB_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,60}$")
REF_RE = re.compile(r"^(?:(?:wisecodeai/)?([A-Za-z0-9._-]+))?#([0-9]+)$")

