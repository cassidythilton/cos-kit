#!/bin/bash
# cos-push-draft <job> <sha256>: push a reviewed draft onto the data-org branch it was made from, so an open PR of
# Cassidy's picks it up.
# cos-push-draft <job> <sha256> <cassidy/issue-topic>: a reviewed DRD or DADR draft made from main goes to a NEW branch of
# his (cos-run gh push --branch, plan item 8). Refuses if that branch already exists on GitHub. Never --force. Runs only from an approved apply batch (cos-run apply); jobs can't call it (the gate blocks it).
# Refuses unless: the base is one of Cassidy's branches (cassidy/...), the diff from the job's base to its commit is
# byte-for-byte the reviewed one (sha256), the branch on GitHub hasn't moved since the job started, and the push is a
# plain fast-forward (never --force).
set -euo pipefail
JOB="${1:?usage: cos-push-draft <job> <sha256> [<new cassidy/ branch>]}"; WANT="${2:?sha256}"; NEWBR="${3:-}"
COS="$HOME/cos"; REPO="$COS/repos/data-org"; R="$COS/outbox/$JOB/receipt.json"; WT="$REPO/.worktrees/cos-$JOB"
[[ "$JOB" =~ ^[a-z0-9][a-z0-9._-]{0,60}$ && "$WANT" =~ ^[0-9a-f]{64}$ ]] || { echo "cos-push-draft: bad arguments" >&2; exit 64; }
[[ -f "$R" && -d "$WT" ]] || { echo "cos-push-draft: no draft receipt or worktree for $JOB" >&2; exit 66; }
BASE="$(jq -r '.draft.base // empty' "$R")"; BASE_SHA="$(jq -r '.draft.base_sha // empty' "$R")"; REVIEWED="$(jq -r '.draft.sha256 // empty' "$R")"
BR="${BASE#origin/}"
# A live branch (a push deploys it): only a docs-only change goes, and only as a [skip-cd] commit, which doesn't deploy.
LIVE_BR=0; jq -e --arg b "$BR" '.branches[$b]' "$HOME/cos/handbook/live-branches.json" >/dev/null 2>&1 && LIVE_BR=1
if [[ $LIVE_BR -eq 1 ]]; then
  NONDOC="$(git -C "$WT" diff --name-only "$BASE_SHA" HEAD | grep -v '\.md$' || true)"
  [[ -z "$NONDOC" ]] || { echo "cos-push-draft: $BR is live (a push deploys it) and this draft changes more than docs ($NONDOC); use its publish step" >&2; exit 65; }
fi
if [[ -n "$NEWBR" ]]; then
  # A new doc branch: the draft was made from main, the target is cassidy/<issue>-<topic>, and it must not exist yet.
  [[ "$BR" == main ]] || { echo "cos-push-draft: refusing: a new branch is only for a draft made from main (this one: $BR)" >&2; exit 65; }
  [[ "$NEWBR" =~ ^cassidy/[0-9]+-[a-z0-9][a-z0-9._-]{0,60}$ ]] || { echo "cos-push-draft: refusing: $NEWBR is not cassidy/<issue>-<topic>" >&2; exit 65; }
  [[ "$(jq -r '.draft.sha256 // empty' "$R")" == "$WANT" ]] || { echo "cos-push-draft: refusing: the approved sha256 isn't this draft's" >&2; exit 67; }
  NOW="$(git -C "$WT" diff --binary "$BASE_SHA" HEAD | shasum -a 256 | cut -d' ' -f1)"
  [[ "$NOW" == "$WANT" ]] || { echo "cos-push-draft: refusing: the draft changed after review" >&2; exit 67; }
  [[ -z "$(git -C "$REPO" ls-remote --heads origin "$NEWBR" 2>/dev/null)" ]] || { echo "cos-push-draft: refusing: $NEWBR already exists on GitHub" >&2; exit 65; }
  git -C "$WT" push -q origin "HEAD:refs/heads/$NEWBR"
  echo "pushed $JOB to a new branch $NEWBR at $(git -C "$WT" rev-parse --short HEAD) (from main at ${BASE_SHA:0:7})"; exit 0
fi
[[ "$BR" =~ ^cassidy/[A-Za-z0-9._/-]+$ && "$BR" != *..* ]] || { echo "cos-push-draft: refusing: $BR is not one of Cassidy's branches" >&2; exit 65; }
[[ "$REVIEWED" == "$WANT" ]] || { echo "cos-push-draft: refusing: the approved sha256 isn't this draft's" >&2; exit 67; }
NOW="$(git -C "$WT" diff --binary "$BASE_SHA" HEAD | shasum -a 256 | cut -d' ' -f1)"
[[ "$NOW" == "$WANT" ]] || { echo "cos-push-draft: refusing: the draft changed after review" >&2; exit 67; }
git -C "$REPO" fetch -q origin "+refs/heads/$BR:refs/remotes/origin/$BR"
[[ "$(git -C "$REPO" rev-parse "origin/$BR")" == "$BASE_SHA" ]] || { echo "cos-push-draft: refusing: $BR moved on GitHub since the draft started. Run the draft again." >&2; exit 65; }
if [[ $LIVE_BR -eq 1 ]] && ! git -C "$WT" log -1 --format=%B | grep -q '\[skip-cd\]'; then
  git -C "$WT" commit -q --amend -m "$(git -C "$WT" log -1 --format=%s) [skip-cd]" -m "$(git -C "$WT" log -1 --format=%b)"
fi
git -C "$WT" push -q origin "HEAD:refs/heads/$BR"
echo "pushed $JOB to $BR$([[ $LIVE_BR -eq 1 ]] && echo ' (docs only, [skip-cd]: no deploy)') at $(git -C "$WT" rev-parse --short HEAD) (fast-forward from ${BASE_SHA:0:7})"
