}
fix_review() {  # commit, diff, hash, guard, the suite in the sandbox, Codex, the checker
  git -C "$WT" add -A; git -C "$WT" diff --cached --quiet || git -C "$WT" commit -q -m "Fix ($JOB)${FIX_ROUND_TAG:-}: $(head -1 "$OUT/brief.md" | cut -c1-90)" -m "Made by cos-run fix; landed only after Cassidy's yes to the diff's sha256." -m "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"
