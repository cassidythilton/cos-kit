if [[ -f "$OUT/apply.sh" ]]; then
  BATCH_SHA="$(shasum -a 256 "$OUT/apply.sh" | cut -d' ' -f1)"; BATCH_N="$(grep -cv '^[[:space:]]*\(#\|$\)' "$OUT/apply.sh" || true)"
  jq --arg s "$BATCH_SHA" --argjson n "${BATCH_N:-0}" '. + {batch: {sha256: $s, writes: $n, file: "apply.sh", approve_with: "cos-run apply \(.job) \($s)"}}' \
     "$OUT/receipt.json" > "$OUT/receipt.tmp" && mv "$OUT/receipt.tmp" "$OUT/receipt.json"
fi

# Build lane: the deterministic check runs here, outside the model, and a second model family reviews the diff.
if [[ "$LANE" == "build" ]]; then
  (cd "$WORKDIR" && ./verify check) > "$OUT/verify.txt" 2>&1 && VX=0 || VX=$?
  git -C "$WORKDIR" diff "$BUILD_BASE"..HEAD > "$OUT/diff.patch" || true
  DIFF="$(head -c 60000 "$OUT/diff.patch")"
  # Canon charter decision 14 (the airlock ruling): a canon term or label context reaches a model only through
  # Data Org tooling built to the AI Data Stewardship Field Guide. Claude Code on this Mac is the sanctioned tool
  # (data-org-notebook AGENTS.md). A second provider is not, so canon and label builds skip the cross-family review.
  if grep -Eqi 'stewardship class[^|]*\|[[:space:]]*(canon|label)' "$WORKDIR/BRIEF.md" 2>/dev/null; then
    echo '{"result":"skipped: this build handles canon or label context (canon charter decision 14). Claude-only review."}' > "$OUT/second-opinion.json"
  else
  (cd "$WORKDIR" && agent -p --mode ask --trust --model gpt-5.3-codex-high --output-format json \
    "Review this diff as a senior engineer who did not write it. Name real defects only: wrong results, unsafe data handling, missing tests for the stated done-means, needless complexity. One line each, most severe first. Say NONE if there are none.

BRIEF:
$(cat BRIEF.md)

DIFF (may be truncated):
$DIFF") > "$OUT/second-opinion.json" 2>>"$OUT/run.err" || true
  fi
  HEAD_SHA="$(git -C "$WORKDIR" rev-parse HEAD)"

  # BASELINE vs TREATMENT: run today's ./verify (and golden sets) against the code as it was before this job.
  # It should fail there and pass now. Passing both times means the check doesn't test this slice.
  BASE_VX=-1; BASE_NOTE="no new commits in this job"
  if [[ "$BUILD_BASE" != "$HEAD_SHA" ]]; then
    TB="$(mktemp -d)"; git -C "$WORKDIR" worktree add -q --detach "$TB/base" "$BUILD_BASE"
    cp "$WORKDIR/verify" "$TB/base/verify"; [[ -d "$WORKDIR/tests" ]] && { rm -rf "$TB/base/tests"; cp -R "$WORKDIR/tests" "$TB/base/tests"; }
    (cd "$TB/base" && ./verify check) > "$OUT/verify-baseline.txt" 2>&1 && BASE_VX=0 || BASE_VX=$?
    git -C "$WORKDIR" worktree remove --force "$TB/base" 2>/dev/null || true
    if   [[ $VX -eq 0 && $BASE_VX -ne 0 ]]; then BASE_NOTE="fail-to-pass: the check failed before this job and passes now"
    elif [[ $VX -eq 0 && $BASE_VX -eq 0 ]]; then BASE_NOTE="passes before and after: the check does not distinguish this slice"
    else BASE_NOTE="still failing after this job"; fi
  fi

  # INDEPENDENT VERIFIER: a fresh Claude that didn't write the code runs it, in a throwaway copy of the workspace
  # (so it can't change the build), criterion by criterion from BRIEF.md. Reading the diff is not verification.
  VERIFY_SCHEMA='{"type":"object","required":["level","criteria","ran"],"properties":{
    "level":{"enum":["live-verified","test-verified","check-only","verifier-blocked","verifier-failed"]},
    "criteria":{"type":"array","items":{"type":"object","required":["criterion","status","evidence"],"properties":{"criterion":{"type":"string"},"status":{"enum":["met","not met","n/a"]},"evidence":{"type":"string"}}}},
    "ran":{"type":"array","items":{"type":"object","required":["command","outcome"],"properties":{"command":{"type":"string"},"outcome":{"type":"string"}}}},
    "findings":{"type":"array","items":{"type":"string"}}}}'
  TV="$(mktemp -d)"; rsync -a --exclude .git --exclude repos/ "$WORKDIR/" "$TV/ws/"
  (cd "$TV/ws" && claude -p "Verify build $SLUG at commit $HEAD_SHA against its BRIEF.md and VERIFY.md. Write any repro scripts or captures to $OUT/verifier/." \
     --settings "$COS/claude/settings.build.json" \
     --permission-mode dontAsk --permission-prompts none \
     --append-system-prompt "$(cat "$COS/claude/verifier.md")" \
     --add-dir "$OUT" "$COS/handbook" \
     --model opus --effort high --max-budget-usd "${COS_VERIFY_BUDGET:-4}" --no-session-persistence \
     --output-format json --json-schema "$VERIFY_SCHEMA") > "$OUT/verifier.json" 2>>"$OUT/run.err" || true
  rm -rf "$TV"

  jq --argjson vx "$VX" --arg v "$(tail -c 2000 "$OUT/verify.txt")" --arg so "$(jq -r '.result // "no review"' "$OUT/second-opinion.json" 2>/dev/null)" \
     --arg base "$BUILD_BASE" --arg head "$HEAD_SHA" --argjson bvx "$BASE_VX" --arg bnote "$BASE_NOTE" \
     --slurpfile vf <(jq '.structured_output // (.result | fromjson?) // {level: "verifier-blocked", criteria: [], ran: [], findings: ["verifier produced no result"]}' "$OUT/verifier.json" 2>/dev/null || echo '{"level":"verifier-blocked","criteria":[],"ran":[],"findings":["verifier did not run"]}') \
     '. + {build: {workspace: "'"$WORKDIR"'", base: $base, head: $head, verify_exit: $vx, verify_tail: $v,
                   baseline: {verify_exit_before: $bvx, reading: $bnote}, verifier: $vf[0], second_opinion: $so}}' \
     "$OUT/receipt.json" > "$OUT/receipt.tmp" && mv "$OUT/receipt.tmp" "$OUT/receipt.json"
fi

# Checker: a fresh, read-only context that must pass the work before it reaches anyone.
VERDICT_SCHEMA='{"type":"object","required":["verdict","failures"],"properties":{"verdict":{"enum":["pass","fail"]},"failures":{"type":"array","items":{"type":"string"}}}}'
claude -p "You are the CHECKER. You did not do this work and you assume nothing. Read $OUT/receipt.json and every artifact it lists.
Fail the job if: any claim lacks evidence or the evidence does not say what the claim says; any 'decision' is not recorded in a DRD/DADR, the board or a transcript;
any owner/date/status was not fetched fresh in this run; anything shared-state was done rather than staged in needs_approval; a file was created that artifacts does not list;
anything bound for data-org contains personnel, compensation, individual performance, verbatim executive quotes, RAGB values, pasted CDO ADR content or unreleased strategy; a file under data-org context/ was edited; a team-bound Markdown file has no clean make lint-writing run; receipt.summary, needs_approval or open_questions contain a canon term or label text (they leave the Mac for the cloud bots, canon charter decision 14); apply.sh (if present) contains a line that is not an allowed board write, touches RAGB or Status on a card not owned by cassidythilton, or does not match what the receipt says it does. For team documents run make gate and make lint-writing.
The allowed apply.sh lines are exactly: make ragb|field|set-pillar|complete|promote|board-add|ship-link|context-request with VAR=value arguments; gh issue comment <n> --repo wisecodeai/<repo> --body-file <job folder>/<file>.md; gh issue create --repo wisecodeai/<repo> --title \"...\" --body-file <job folder>/<file>.md [--assignee <login>] [--milestone \"<title>\"] [--label <label>]... in that order; cos-link sub|blocked-by <ref> <ref>, where a ref is wisecodeai/<repo>#<n> or @N (the Nth card this batch creates, also usable as CARD=@N or URL=@N); for builds, a git push of a <name>/<branch> build branch and gh pr create --draft. A staged comment is allowed; posting it is not. sheet.json (if present) fails the job unless each write names the Data Roadmap or Pillar Metrics tab, its row number, row_name exactly as column A read in this run, old exactly as read in this run, and new; never Data Roadmap column A, J or K or a Pillar Metrics formula column; and the receipt describes the same cells.
You can read every file with the Read tool. Shell is limited to read-only commands, so don't fail a job only because you couldn't re-run a check yourself: judge the evidence the job recorded.
Proofs are required for build jobs. For other lanes, judge any proofs present.
Proofs: every entry in receipt.proofs needs a status. FAIL that the job did not fix and re-run, or NOT_RUN without a blocker, fails the job. A proof whose 'observed' just restates 'expected' fails.
For a build: fail if verify_exit is not 0; if build.baseline.reading says the check passes before and after (a vacuous check) and the receipt claims new behavior;
if build.verifier.level is verifier-failed or verifier-blocked, or check-only for anything beyond a typing change; if any verifier criterion is 'not met';
if proofs lacks BASELINE, BEHAVIOR or QUALITY; if HANDOFF.md was not updated; if a claim of improvement has no number and denominator; if a query read canon values;
or if the second opinion names a defect the receipt does not address.
Return pass only if every check passes. List each failure in one line." \
  --settings "$COS/claude/settings.investigate.json" \
  --permission-mode dontAsk --permission-prompts none \
  --add-dir "$OUT" "$COS/handbook" "$HOME/meetings" ${WORKDIR:+"$WORKDIR"} \
  --model opus --effort medium --max-budget-usd 1.5 --no-session-persistence \
  --output-format json --json-schema "$VERDICT_SCHEMA" > "$OUT/checker.json" 2>>"$OUT/run.err" || true

jq -s '.[0] + {checker: (.[1].structured_output // (.[1].result|fromjson?) // {verdict:"fail",failures:["checker did not run"]})}' \
   "$OUT/receipt.json" "$OUT/checker.json" > "$OUT/receipt.tmp" && mv "$OUT/receipt.tmp" "$OUT/receipt.json"
finish
