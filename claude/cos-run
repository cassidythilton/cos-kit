  [[ "$(jq -r '.landed.commit // empty' "$R")" == "" ]] || { echo "already landed" >&2; exit 68; }
  git -C "$KITD" diff "$BASE" "$BR" > "$OUT/fix.now.diff"
  [[ "$(shasum -a 256 "$OUT/fix.now.diff" | cut -d' ' -f1)" == "$BRIEF_IN" ]] || { echo "refusing: the fix branch changed after review" >&2; exit 67; }
  [[ "$(fix_guard "$BASE")" == "$(fix_guard "$BR")" ]] || { echo "refusing: the fix changes the fix lane itself" >&2; exit 65; }
