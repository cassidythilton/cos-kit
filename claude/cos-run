# Jobs share one clone and the $MAIN worktree, so one job at a time fetches and checks out (Nov 12: two atlas jobs
# started in the same second and atlas-20261112-imgx died on $MAIN's index.lock). The lock file holds a pid; shlock
# takes over a lock whose pid is gone. A live holder is waited on for 5 minutes, then the job stops: it never goes on
# without the lock.
MAIN_LOCK="$COS/state/data-org-main.lock"
main_lock() { local i w="${COS_LOCK_WAIT:-300}"; mkdir -p "$COS/state"; for i in $(seq 1 "$w"); do shlock -f "$MAIN_LOCK" -p $$ && return 0; sleep 1; done
  echo "$(date +%FT%T) $JOB: pid $(cat "$MAIN_LOCK" 2>/dev/null) held $MAIN_LOCK for ${w}s; stopped" >> "$COS/state/git-prep.err"
  echo "data-org-main is busy: pid $(cat "$MAIN_LOCK" 2>/dev/null) has held $MAIN_LOCK for ${w}s. Nothing ran. Try again." >&2; exit 75; }
main_unlock() { [[ "$(cat "$MAIN_LOCK" 2>/dev/null)" == "$$" ]] && rm -f "$MAIN_LOCK"; return 0; }
# A git index.lock is removed only when it is provably dead: 2+ minutes old, no process has it open, and no git process
# is working in that worktree. Otherwise it stays, and git's own error stops the job.
clear_stale_index_lock() { local l d; l="$(git -C "$1" rev-parse --path-format=absolute --git-path index.lock 2>/dev/null)" || return 0
  [[ -f "$l" && -n "$(find "$l" -mmin +2 2>/dev/null)" ]] && command -v lsof >/dev/null || return 0
  d="$(cd "$1" && pwd -P)"
  lsof -t -- "$l" >/dev/null 2>&1 && return 0
  lsof -a -c git -d cwd -Fn 2>/dev/null | grep -qE "^n$d(/|$)" && return 0
  rm -f "$l"; echo "$(date +%FT%T) $JOB: removed a dead $l (2+ min old, no process holds it, no git in $d)" >> "$COS/state/git-prep.err"; }

# Jobs never run in Cassidy's working checkout (it may sit on a feature branch with uncommitted files).
