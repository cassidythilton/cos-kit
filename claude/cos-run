#!/bin/bash
# cos-run: the one sanctioned way the Grok Chief reaches work on this Mac.
#
#   cos-run quick       <job-id> "<question>" [--with "<read-only command>"]...   Cursor Agent, ask mode, cheap model
#   cos-run investigate <job-id> "<brief>"    [--in <folder>] [--resume <id>]    Claude Code, touches nothing
#   cos-run draft       <job-id> "<brief>"    [--in <folder>] [--resume <id>]    Claude Code, own branch, never pushed
#                       [--doc drd|dadr --card <his card>]  a DRD or DADR by data-org's draft skills, his cards only
#                       [--base <branch>]  the data-org branch to start from (default main), fetched fresh; the receipt
#                       carries draft.diff's sha256 against it
#   cos-run apply      <job-id> <sha256>                                         runs a reviewed write batch, once
#   cos-run apply-sheet <job-id> <sha256>                                         writes a reviewed sheet.json, cell by cell, once
#   cos-run gh-scan     <job-id> [since] [--state brief|watch]                    everything in GitHub that may need Cassidy, no model
#   cos-run atlas       <job-id> "<the name he used>"                             finds a past chat in Agent Atlas, read-only
#   cos-run fix         <job-id> "<problem>"                                      Claude fixes the kit in its own copy, tested in a sandbox
#   cos-run land        <job-id> <sha256>|revert                                  lands (or undoes) a reviewed fix: merge, install, push
#   cos-run build       <job-id> "<brief>" --slug <slug>                          headless build session in ~/builds/<slug> (made from
#                                                                                  the template if new), then baseline-vs-treatment ./verify
#                                                                                  and an independent verifier
#   cos-run gh          <job-id> <action> ...                                     tier-0 GitHub writes, each in the ledger with its undo (cos-gh)
#   cos-run lake        <job-id> "<question>" [--env dev|uat|prod]                one data question, Cursor CLI in a walled workspace, after his yes
#   cos-run eval        <suite> current|<proposed-lane-prompt.md>                 blinded A/B of the investigate lane on a fixed suite
#   cos-run preview     <job-id>                                                  a staged batch in plain words, with what to run on his yes
#   cos-run seal        <job-id>                                                  hashes a staged cos-share (share.json) and makes its apply.sh
#   cos-run note        <bot> "<what went wrong, and the rule>"                   appends one correction to ~/cos/state/corrections.jsonl
#   cos-run pause       <slot|all> <days>                                         holds a scheduled slot for N days (0 resumes)
#   cos-run receipt     <job>                                                     a job's result, or "running" / "didn't finish, rerun?"
#   cos-run slack-read  <job-id> "<what to read>"                                Slack read on the Mac (read tools only)
#   cos-run slack-draft <job-id> <draft.json>                                     saves ONE draft in Cassidy's Slack Drafts; never sends
#   cos-run done        <data-org#700> "<how>"                                  Cassidy finished it: closed on the one owed list, comes back only if something new happens
#   cos-run owed        list                                                      what he owes, checked live against GitHub, in plain words
#   cos-run packet      morning|evening                                           rebuild the brief packet by hand (the Mac makes it at 5:45 and 4:12)
#   cos-run night       add|propose|approve|status|report ...                     the night shift queue and budget (run is launchd only)
#   cos-run memory      propose|accept|reject|retire|list|show|status|render ...  the one memory store
#   cos-run mail-read   <job-id> "<what to read>"                                Gmail read on the Mac (read tools only)
#   cos-run mail-draft  <job-id> <draft.json>                                     saves ONE draft in Cassidy's Gmail Drafts; never sends
#   cos-run heartbeat   <routine-id> ok|failed ["<what>"]                       a Grok routine reports in (cos-health watches for it)
#   cos-run preflight   <lane> [job-id]                                           what that lane needs, checked now; no model, no receipt
#   add --async to investigate, atlas, draft, build, eval, fix, land or lake: returns at once, runs detached, pushes the receipt to the Chief
#   cos-run <lane> --help prints that lane's arguments and examples. A refused call prints the correct one.
#
# Writes everything to ~/cos/outbox/<job-id>/ and prints receipt.json. Nothing else leaves this script.
set -euo pipefail

LANES_ALL="quick investigate atlas gh-scan draft build apply apply-sheet preview seal gh lake eval fix land note pause receipt preflight heartbeat slack-read slack-draft done owed packet night memory mail-read mail-draft"
lane_help() {  # cos-run <lane> --help. Examples first-class: an agent copies them (poteto/plugins cli-for-agent).
  case "${1:-}" in
    quick) cat <<'H'
cos-run quick <job> "<question>" --with "<read-only command>" [--with ...]
  Cursor Agent (cheap model) answers from the output of the commands you pass. Its model runs nothing itself.
  Reads only: make board|stale|weed|roadmap-check|ship-check|raqs|..., gh issue|pr view|list|diff|checks, gh search,
  gh api (GET), git log|show|grep|..., cat, head, sed -n, ls, board-pulse, cos-flow lanes|week|evidence|nostatus|today|debt.
  No ; & | ` $ < >. Quote ">=" filters.
Examples:
  cos-run quick q-stale "Which of my cards are stale?" --with "make stale DAYS=3"
  cos-run quick q-prs "What PRs wait on me?" --with "gh pr list --repo wisecodeai/data-org --search 'review-requested:@me'"
  cos-run quick q-flow "How did throughput look this week?" --with "cos-flow week" --with "cos-flow lanes"
H
;;
    investigate|atlas|draft) cat <<'H'
cos-run investigate <job> "<brief>" [--in <folder>] [--resume <session>] [--async]
cos-run atlas       <job> "<the name Cassidy used for a past chat>" [--async]
cos-run draft       <job> "<brief>" [--base <branch>] [--resume <session>] [--async]
cos-run draft       <job> "<brief>" --doc drd|dadr --card <his card> [--resume <session>] [--async]
  Claude Code reads widely and writes only in the job folder (draft: its own cassidy/cos-<job> branch, never pushed by
  the job). A checker grades the receipt; one revision round runs if it blocks. Receipt verdict: VERIFIED (checker
  passed), NOT VERIFIED (it blocked), INCONCLUSIVE (it didn't run). Over 3 minutes? Use --async.
  --doc: a DRD or DADR on Cassidy's own card only, from main, by data-org's draft-drd / draft-dadr skill. Round 1
  returns at most three numbered questions; resume with his answers for round 2 (make next-id, scaffold, gate, lint).
  Never flips a status to Approved or accepted; never a DRD and a DADR in one diff. Another owner's card: refused.
Examples:
  cos-run investigate inv-720-status "What does PR #720 still need? Five lines, with links." --async
  cos-run atlas atlas-dash "the dashboard chat"
  cos-run draft dr-720-fix "Fix the broken link in docs/x.md" --base cassidy/720-topic --async
  cos-run draft drd-712 "He wants the label-facts requirement written up" --doc drd --card data-org#712 --async
  cos-run draft drd-712 "1-yes 2-Cassidy 3-skip" --resume <session from round 1> --async
H
;;
    gh-scan) cat <<'H'
cos-run gh-scan <job> [since] [--state brief|watch]
  One read-only pass over everything in GitHub that may need Cassidy. No model. Each caller keeps its own "since":
  --state brief for the morning and evening briefs, --state watch for the hourly watch, so a watch never hides
  overnight activity from the morning brief. PRs others assigned to him are always listed.
Examples:
  cos-run gh-scan scan-brief-20261114 --state brief
  cos-run gh-scan scan-watch-20261114-0900 --state watch
  cos-run gh-scan scan-20261114 2026-11-13T16:00:00Z
H
;;
    build) cat <<'H'
cos-run build <job> "<brief>" --slug <slug> [--async]
  A headless build slice in ~/builds/<slug> (made from the build template the first time), then ./verify before and
  after, an independent verifier and a second-opinion review. Data comes from a cos-run lake result, not a live query.
Examples:
  cos-run build b-scan-1 "Slice 1 of BRIEF.md: the loader" --slug scan-demand --async
H
;;
    apply|apply-sheet) cat <<'H'
cos-run apply       <job> <sha256>     runs that job's apply.sh, once, only if it is byte-for-byte what Cassidy approved
cos-run apply-sheet <job> <sha256>     writes that job's sheet.json cells, once, the same way
  Only after his yes to the batch (show it with: cos-run preview <job>). The sha256 is in the job's receipt
  (batch.sha256 or sheet_batch.sha256); keep it to yourself and pass it here.
Examples:
  cos-run preview inv-720-status
  cos-run apply inv-720-status 3f9a...e1    (the full 64-character sha256 from the receipt)
H
;;
    preview) cat <<'H'
cos-run preview <job>
  A staged batch (apply.sh, sheet.json) in plain words, each line with its tier, and the exact call to run on his yes.
  Show him the words, not the sha256.
Examples:
  cos-run preview inv-720-status
H
;;
    seal) cat <<'H'
cos-run seal <job>
  For a cos-share job that left share.json with content_sha256 empty and apply.pending.sh (jobs can't hash a folder).
  Checks share.json's source folder and items the way cos-share does, writes content_sha256, puts share.json's sha256
  in place of SHARE_SHA and renames apply.pending.sh to apply.sh. No model. Writes only in the job folder; pushes and
  posts nothing. Running it again changes nothing. Then preview and apply as usual, after his yes.
Examples:
  cos-run seal share-backlog974-20261117
  cos-run preview share-backlog974-20261117
H
;;
    gh) "$HOME/cos/bin/cos-gh" --help ;;
    lake) cat <<'H'
cos-run lake <job> "<question>" [--env dev|uat|prod] [--async]
  Tier 1: show Cassidy the question, the tables you expect it to read and the shape of the answer; run it on his yes.
  Never in tier 0, never on a schedule. A Cursor agent (pinned to a Claude model) answers on this Mac, walled by
  Cursor's permission config and a hook that runs the gate: it can read and run lake-query, nothing else. The answer
  is ~/cos/outbox/<job>/result.md (counts, rates, ids, each with its query). Canon tables touched: held on the Mac.
  No VPN or sign-in: it stops at once and says "connect the VPN and sign in".
Examples:
  cos-run lake lake-avail-n1 "How many available foods have an NFP15 panel? Count and rate, lake dev." --async
H
;;
    eval) cat <<'H'
cos-run eval <suite> current|<proposed-lane-prompt.md> [--async]
  A blinded A/B of the investigate lane on ~/cos/evals/<suite>.json (1 to 8 cases), judged by a different model
  family. KEEPER's test for a prompt or skill change before it's proposed. Expect about $4 a case per arm.
Examples:
  cos-run eval core current --async
  cos-run eval core ~/cos/outbox/keeper-20261120/lane.proposed.md --async
H
;;
    fix|land) cat <<'H'
cos-run fix  <job> "<problem>" [--async]        Claude fixes the kit in its own copy, tested in a sandbox, reviewed
cos-run land <job> <sha256>|revert [--async]    lands a reviewed fix after Cassidy's yes, or undoes a landed one
Examples:
  cos-run fix fix-capture-logs "The capture brief misses the daily-log rule (docs/2026-10-12-work-system.md)" --async
  cos-run land fix-capture-logs revert
H
;;
    note) cat <<'H'
cos-run note <chief|ops|steward|builder|keeper|claude|cursor|cos-run> "<what went wrong, and the rule>"
Examples:
  cos-run note chief "Lead with the answer; no job ids unless he asks."
H
;;
    pause) cat <<'H'
cos-run pause <all|followups|pulse|reconcile|capture|week|opportunity|keeper> <days>    (0 resumes)
Examples:
  cos-run pause week 7
  cos-run pause week 0
H
;;
    heartbeat) cat <<'H'
cos-run heartbeat <routine-id> ok|failed ["<what>"]   a Grok routine's last step, so the Mac's monitoring knows it ran
  The id is the routine's id in ~/cos/handbook/expected-runs.json. "failed" says what didn't work, in one line.

Examples:
  cos-run heartbeat chief-morning-brief ok
  cos-run heartbeat chief-evening-sweep failed "couldn't read today's capture receipt"
H
;;
    slack-read|slack-draft) cat <<'H'
cos-run slack-read  <job> "<what to read>"   reads Slack on the Mac (read tools only) and reports what's waiting on Cassidy
cos-run slack-draft <job> <draft.json>       saves ONE draft in Cassidy's Slack Drafts, word for word; never sends
  draft.json: {"to": "<channel or user id, or a name>", "text": "<the message>", "thread_ts": "<optional>", "why": "<one line>"}
  No agent can send a Slack message. Cassidy reviews and sends every draft from Slack himself.

Examples:
  cos-run slack-read sl-brief-20261120 "every DM, group DM and thread I'm in with activity since 4:30 PM yesterday"
  cos-run slack-draft sd-steve-20261120 ~/cos/outbox/sd-steve-20261120/draft.json
H
;;
    packet|night|memory) cat <<'H'
cos-run packet morning|evening        the brief packet, rebuilt by hand (the Mac's schedule makes it at 5:45 AM and 4:12 PM)
cos-run night add <kind> "<what>"     queue a night-shift job; kinds: cos-run night kinds
cos-run night propose                 tonight's plan, inside the budget, in plain words
cos-run night approve <ids|all>       Cassidy's yes to tonight's plan; nothing runs without it
cos-run night status | report         the queue, or the "While you slept" report
cos-run memory propose "<text>" --kind rule|fact --bots chief|all --source "<where>" [--review-by YYYY-MM-DD]
cos-run memory accept|reject <id>     on Cassidy's word only
cos-run memory list | status | render <bot>

Examples:
  cos-run night add meeting-prep "Tomorrow: 9:00 Team check-in (David, Melanie); 1:00 Datasembly with Greta"
  cos-run night propose
  cos-run memory propose "Cassidy sends every message himself" --kind rule --bots all --source "Cassidy, Nov 19"
H
;;
    done|owed) cat <<'H'
cos-run done <card or PR> "<how it was finished>"   Cassidy says it's done: closed on the one owed list
cos-run owed list                                   what he owes, checked live against GitHub, as linked plain lines
  A closed item comes back only if someone asks again after it was closed, or a review gets a new commit.

Examples:
  cos-run done data-org#700 "answered David in the thread"
  cos-run owed list
H
;;
    receipt) cat <<'H'
cos-run receipt <job>
  The result if finished; "running" while it works; "interrupted" with the rerun command if it stopped early.
Examples:
  cos-run receipt inv-720-status
H
;;
    preflight) cat <<'H'
cos-run preflight <quick|investigate|atlas|draft|build|lake|apply-sheet|eval> [job]
  Checks what that lane needs before it spends: the CLI, the rules its settings must allow, gh signed in with GraphQL
  and REST calls to spare (COS_GH_MIN_REMAINING, default 100), and that day's transcript in ~/cos/zoom for
  calls-<yyyymmdd> jobs. Read-only, no model. Each of these lanes runs it before its first model call; a lane that fails
  gets a blocked_preflight receipt with the reason and no model call. The Sheets connector (for sheet-* jobs and
  apply-sheet) is a warning only: a ledger row and a note in the receipt, never a block.
Examples:
  cos-run preflight investigate
  cos-run preflight investigate calls-20261113
  cos-run preflight atlas
H
;;
    *) echo "cos-run <lane> <job> ...   Lanes: $LANES_ALL"; echo "Each lane: cos-run <lane> --help" ;;
  esac
}
words() {  # a command line a person can read and paste back: plain words bare, the rest in double quotes
  local a o=""; for a in "$@"; do
    if [[ "$a" =~ ^[A-Za-z0-9._/:=@#,+-]+$ ]]; then o+="$a "
    else a="${a//\\/\\\\}"; a="${a//\"/\\\"}"; a="${a//\$/\\\$}"; a="${a//\`/\\\`}"; o+="\"$a\" "; fi
  done; printf '%s' "${o% }"; }
usage_fail() {  # refuse fast, and print the call that would have worked
  echo "cos-run $1: $2" >&2
  { echo "Correct call:"; lane_help "$1" | sed -n '/^Examples:/,$p' | sed 1d; } >&2 || true
  exit "${3:-64}"
}
ALL_ARGS=("$@")
for a in "$@"; do [[ "$a" == --help || "$a" == -h ]] && { lane_help "${1:-}"; exit 0; }; done
LANE="${1:-}"
[[ " $LANES_ALL " == *" $LANE "* && -n "$LANE" ]] || { [[ -n "$LANE" ]] && echo "unknown lane: $LANE" >&2; lane_help ""; exit 64; }
# Survive an interrupted call (Nov 18). When Cassidy replies while a call runs, Grok stops the call. So every lane that
# does work runs in its own session and this process only waits for it: a stop ends the wait, never the job. An apply
# finishes its whole batch, a quick read finishes and keeps its output. Fast lanes and --async (already detached) skip it.
if [[ -z "${COS_DETACHED:-}" && " ${ALL_ARGS[*]} " != *" --async "* && ! "$LANE" =~ ^(receipt|preview|seal|note|pause|preflight|heartbeat)$ ]]; then
  RJ="${2:-}"; [[ "$RJ" =~ ^[a-z0-9][a-z0-9._-]{0,60}$ ]] || RJ="nojob"
  RD="$HOME/cos/state/runs"; mkdir -p "$RD"; F="$RD/$LANE-$RJ"
  COS_DETACHED=1 nohup perl -e 'use POSIX qw(setsid); setsid(); exec @ARGV' "$0" "$@" > "$F.out" 2> "$F.err" < /dev/null &
  c=$!; echo "$c" > "$F.pid"
  trap 'echo "cos-run: this call was interrupted, but the $LANE job keeps running on the Mac and finishes on its own. Read its result with: cos-run receipt $RJ (never run it again)" >&2; exit 130' INT TERM HUP
  rc=0; wait "$c" || rc=$?  # set -e: a failed lane must still print its output
  cat "$F.out"; cat "$F.err" >&2; rm -f "$F.pid"; exit "$rc"
fi
# Tier-0 GitHub writes live in one small script with no model. It writes its own ledger rows and receipts.
[[ "$LANE" == gh ]] && exec "$HOME/cos/bin/cos-gh" "${@:2}"
JOB="${2:-}"; [[ -n "$JOB" ]] || usage_fail "$LANE" "missing the job id"
BRIEF_IN="${3:-}"
# done / owed (Nov 19, plan change 10): one owed list, on the Mac. No model.
if [[ "$LANE" == done ]]; then
  [[ -n "$BRIEF_IN" ]] || usage_fail done "say how it was finished: cos-run done data-org#700 \"answered David in the thread\""
  exec "$HOME/cos/bin/cos-obligations" --done "$JOB" "$BRIEF_IN"
fi
if [[ "$LANE" == owed ]]; then
  [[ "$JOB" == list ]] || usage_fail owed "cos-run owed list"
  exec "$HOME/cos/bin/cos-obligations" --list
fi
# packet / night / memory (Nov 19, plan changes 3, 8 and 11). No model here; each tool has its own --help.
if [[ "$LANE" == packet ]]; then
  [[ "$JOB" =~ ^(morning|evening)$ ]] || usage_fail packet "cos-run packet morning|evening"
  exec "$HOME/cos/bin/cos-packet" "${@:2}"
fi
if [[ "$LANE" == night ]]; then
  [[ "$JOB" =~ ^(add|propose|approve|status|report|kinds)$ ]] || usage_fail night "cos-run night add|propose|approve|status|report (the run itself starts only from the Mac's schedule)"
  exec "$HOME/cos/bin/cos-night" "${@:2}"
fi
if [[ "$LANE" == memory ]]; then
  [[ "$JOB" =~ ^(propose|accept|reject|retire|pin|unpin|list|show|status|render|history)$ ]] || usage_fail memory "cos-run memory propose|accept|reject|retire|list|show|status|render (import, clean and undo are Cassidy's or the schedule's)"
  exec "$HOME/cos/bin/cos-memory" "${@:2}"
fi
# heartbeat (Nov 19): a Grok routine's last step, so cos-health knows it ran. No model, nothing else.
if [[ "$LANE" == heartbeat ]]; then
  [[ "$JOB" =~ ^[a-z0-9][a-z0-9-]{0,60}$ ]] || usage_fail heartbeat "the routine id: lowercase letters, digits and dashes, as in handbook/expected-runs.json"
  [[ "$BRIEF_IN" =~ ^(ok|failed)$ ]] || usage_fail heartbeat "the second value is ok or failed"
  NOTE="${4:-}"; NOTE="${NOTE:0:500}"
  "$HOME/cos/bin/cos-ledger" heartbeats routine="$JOB" status="$BRIEF_IN" note="$NOTE" >/dev/null 2>&1 || true
  jq -n --arg r "$JOB" --arg s "$BRIEF_IN" '{routine: $r, heartbeat: $s, recorded: true}'; exit 0
fi
[[ -n "$BRIEF_IN" || "$LANE" =~ ^(receipt|gh-scan|preview|seal|preflight)$ ]] || usage_fail "$LANE" "missing the third argument (the brief, the question or the lane's value)"
if [[ "$LANE" == gh-scan && "$BRIEF_IN" == --* ]]; then BRIEF_IN=""; shift 2; else shift $(( $# < 3 ? $# : 3 )); fi
export PATH="$HOME/cos/bin:$PATH"
# Jobs use their own clones under ~/cos/repos. launchd jobs cannot read ~/Documents (macOS privacy, TCC),
# so nothing a job needs may live there. Cassidy's checkout in ~/Documents is never touched.
COS="$HOME/cos"; REPO="$COS/repos/data-org"; MAIN="$COS/data-org-main"; NBREPO="$COS/repos/data-org-notebook"
ZOOM=""; for z in "$COS/zoom" "$HOME/Documents/Zoom"; do [[ -d "$z" && -r "$z" ]] && { ZOOM="$z"; break; }; done
# Best-effort. A ledger failure must not change the lane's exit code.
ledger() { "$HOME/cos/bin/cos-ledger" "$@" >/dev/null 2>&1 || true; }
IN=""; RESUME=(); WITH=(); SLUG=""; BUILDS="$HOME/builds"; ASYNC=0; TIER2=0; BASE=""; LAKE_ENV="dev"; SCAN_STATE=""; DOC=""; DOC_CARD=""
while [[ $# -gt 0 ]]; do
  [[ "$1" =~ ^--(in|base|resume|with|slug|env|state|doc|card|from)$ && $# -lt 2 ]] && usage_fail "$LANE" "$1 needs a value"
  case "$1" in
    --state) [[ "$LANE" == gh-scan && "$2" =~ ^(brief|watch)$ ]] || usage_fail "$LANE" "--state is for gh-scan: brief (the morning and evening briefs) or watch (the hourly watch)"
             SCAN_STATE="$2"; shift 2 ;;
    --doc) [[ "$LANE" == draft && "$2" =~ ^(drd|dadr)$ ]] || usage_fail "$LANE" "--doc is for draft: drd or dadr"
           DOC="$2"; shift 2 ;;
    --card) [[ "$LANE" == draft && "$2" =~ ^((wisecodeai/)?[A-Za-z0-9._-]+)?#[0-9]+$ ]] || usage_fail "$LANE" "--card is for draft: data-org#712"
            DOC_CARD="$2"; shift 2 ;;
    --in) IN="$2"; shift 2 ;;
    --base) BASE="$2"; shift 2
            [[ "$BASE" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,100}$ && "$BASE" != *..* ]] || usage_fail "$LANE" "bad --base branch '$BASE'" ;;
    --resume) RESUME=(--resume "$2"); shift 2 ;;
    --with) WITH+=("$2"); shift 2 ;;
    --slug) SLUG="$2"; shift 2 ;;
    --env) LAKE_ENV="$2"; shift 2; [[ "$LAKE_ENV" =~ ^(dev|uat|prod)$ ]] || usage_fail "$LANE" "--env is dev, uat or prod" ;;
    --async) ASYNC=1; shift ;;
    --tier2) [[ "$LANE" == apply ]] || usage_fail "$LANE" "--tier2 is only for apply"; TIER2=1; shift ;;
    --from) [[ "$2" =~ ^[a-z0-9][a-z0-9-]{0,60}$ ]] || usage_fail "$LANE" "--from is the routine that started this call, as in handbook/expected-runs.json"
            export COS_ROUTINE="$2"; shift 2 ;;
    *) usage_fail "$LANE" "unknown option: $1" ;;
  esac
done

# Every lane except receipt (a poll) and preflight (a check by hand) records a start and an end. The end runs from EXIT so a
# crash and a normal return both land. async is 1 on the parent that returns immediately,
# child on the detached run, and 0 otherwise. COS_JOB and COS_LANE let the gate attribute blocks.
if [[ ! "$LANE" =~ ^(receipt|preflight)$ ]]; then
  export COS_JOB="$JOB" COS_LANE="$LANE"
  COS_T0=$SECONDS
  if [[ "${COS_ASYNC_CHILD:-}" == 1 ]]; then COS_ASYNC_FLAG=child
  elif [[ "$ASYNC" -eq 1 ]]; then COS_ASYNC_FLAG=1
  else COS_ASYNC_FLAG=0; fi
  # Who started what (Nov 19): the caller, the routine (--from, or the schedule's slot) and the job that started this one.
  PARENT_JOB="${COS_PARENT_JOB:-}"; [[ "$PARENT_JOB" == "$JOB" ]] && PARENT_JOB=""
  ledger jobs event=start job="$JOB" lane="$LANE" async="$COS_ASYNC_FLAG" pid="$$" caller="${COS_CALLER:-bot}" routine="${COS_ROUTINE:-}" parent="$PARENT_JOB"
  [[ "${COS_ASYNC_CHILD:-}" == 1 ]] || export COS_PARENT_JOB="$JOB"
  RUN_MARK=""
  on_exit() { local rc=$?
    "$HOME/cos/bin/cos-ledger" jobs event=end job="$JOB" lane="$LANE" exit="$rc" secs="$((SECONDS - COS_T0))" async="$COS_ASYNC_FLAG" >/dev/null 2>&1 || true
    [[ -n "$RUN_MARK" && "$(cat "$RUN_MARK" 2>/dev/null)" == "$$" ]] && rm -f "$RUN_MARK"; return 0; }
  trap on_exit EXIT
fi
# Long lanes: mark the job running (cos-run receipt tells "running" from "didn't finish") and keep the Mac awake while
# this process lives. caffeinate -s holds only on AC power and a closed lid still sleeps, so the brief for overnight
# work says "plugged in, lid open" before Cassidy approves it.
long_lane() {
  [[ "$JOB" =~ ^[a-z0-9][a-z0-9._-]{0,60}$ ]] || return 0
  RUN_MARK="$HOME/cos/outbox/$JOB/.running"; mkdir -p "$(dirname "$RUN_MARK")"
  echo $$ > "$RUN_MARK"
  [[ "${COS_ASYNC_CHILD:-}" == 1 ]] || words "$0" "${ALL_ARGS[@]}" > "$(dirname "$RUN_MARK")/.cmd"
  command -v caffeinate >/dev/null && { caffeinate -i -s -w $$ >/dev/null 2>&1 & } || true
}

# Preflight: what each lane needs, checked before it spends on a model. Read-only, no model, a few seconds.
# Nov 9-14, 11 of 276 jobs ended blocked or failed on plumbing after a paid run: atlas Bash denied, the Sheets connector
# not attached, GitHub's GraphQL rate limit, Zoom transcripts not yet in ~/cos/zoom (opportunity-adhoc-20261114-1905).
#   lane         CLI     settings file             rules it must allow                     GitHub
#   quick        agent   -                         -                                       when a --with reads GitHub
#   investigate  claude  settings.investigate      Read, Bash(gh pr view *)                yes
#   atlas        claude  settings.investigate      Bash(cos-atlas *)                       no
#   draft        claude  settings.draft            Read, Bash(git commit *)                yes
#   build        claude  settings.build            Read, Bash(./verify *)                  no
#   lake         agent   (the lane checks its own notebook, VPN and sign-in)              no
#   apply-sheet  claude  settings.sheet            Sheets get_values and update_values     no
#   eval         claude, agent (the judge)  settings.investigate  as investigate (its cases are investigate jobs)  yes
# The fix lane has no preflight: its block can't change from a fix job. By job id: sheet-* also needs Sheets get_values;
# calls-<yyyymmdd>* needs a transcript for that day in ~/cos/zoom. GitHub: signed in (the active account), and at least
# COS_GH_MIN_REMAINING (default 100) GraphQL and REST calls left. Only evidence blocks: a rate limit that can't be read
# is not a reason to stop. The Sheets connector (apply-sheet, sheet-* jobs) only warns, with a ledger row and a note in
# the receipt, until a real `claude mcp list` from this Mac shows the format the check reads.
pf_mask() {  # tokens never leave in a reason (the same patterns cos-ledger and cos-sched cut)
  printf '%s' "$1" | sed -E -e 's/gh[pousr]_[A-Za-z0-9_]+/<redacted>/g' -e 's/github_pat_[A-Za-z0-9_]+/<redacted>/g' \
    -e 's/xox[bpas]-[A-Za-z0-9-]+/<redacted>/g' -e 's/sk-[A-Za-z0-9_-]{20,}/<redacted>/g' -e 's/AKIA[0-9A-Z]{16}/<redacted>/g' \
    -e 's/[Bb][Ee][Aa][Rr][Ee][Rr][[:space:]]+[^[:space:]]+/Bearer <redacted>/g' -e 's#(https?://)[^[:space:]/@]*@#\1#g'; }
preflight() {  # $1 lane, $2 job id. Prints why the lane can't run (one line) and returns 1; returns 0 when it can.
  local lane="$1" job="${2:-}" cli=claude set="" gh=0 day="" r rl k rem lim rs f out; local -a why=() rules=()
  case "$lane" in
    quick)       cli=agent; for r in ${WITH[@]+"${WITH[@]}"}; do [[ "$r" =~ ^(gh|make|board-pulse)( |$) ]] && gh=1; done ;;
    investigate) set=settings.investigate.json; rules=("Read" "Bash(gh pr view *)"); gh=1 ;;
    atlas)       set=settings.investigate.json; rules=("Bash(cos-atlas *)") ;;
    draft)       set=settings.draft.json; rules=("Read" "Bash(git commit *)"); gh=1 ;;
    build)       set=settings.build.json; rules=("Read" "Bash(./verify *)") ;;
    lake)        cli=agent ;;
    apply-sheet) set=settings.sheet.json; rules=("mcp__claude_ai_Google_Sheets__get_values" "mcp__claude_ai_Google_Sheets__update_values") ;;
    eval)        cli="claude agent"; set=settings.investigate.json; rules=("Read" "Bash(gh pr view *)"); gh=1 ;;
    *) echo "no preflight for lane '$lane' (quick, investigate, atlas, draft, build, lake, apply-sheet, eval)"; return 2 ;;
  esac
  [[ "$job" == sheet-* && -n "$set" ]] && rules+=("mcp__claude_ai_Google_Sheets__get_values")
  [[ "$job" =~ ^calls-([0-9]{4})([0-9]{2})([0-9]{2}) ]] && day="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}"
  [[ "$job" == calls-* && -z "$day" ]] && day="$(date +%F)"
  for r in $cli; do command -v "$r" >/dev/null 2>&1 || why+=("$r is not on PATH"); done
  if [[ -n "$set" ]]; then f="$COS/claude/$set"
    if ! jq -e . "$f" >/dev/null 2>&1; then why+=("$f is missing or not JSON (run ./install.sh)")
    else for r in "${rules[@]}"; do
      jq -e --arg r "$r" '(.permissions.allow // [] | index($r)) and ((.permissions.deny // [] | index($r)) | not)' "$f" >/dev/null 2>&1 \
        || why+=("the $lane lane's $set doesn't allow $r"); done; fi
  fi
  if [[ $gh -eq 1 ]]; then
    # --active checks only the account gh uses, so a second, stale account doesn't block. A gh without --active fails
    # it as an unknown flag and falls back to the plain check.
    if ! { gh auth status --active >/dev/null 2>&1 || gh auth status >/dev/null 2>&1; }; then why+=("gh is not signed in (gh auth status failed; run gh auth login)")
    elif rl="$(gh api rate_limit 2>/dev/null)"; then
      for k in graphql:GraphQL core:REST; do
        rem="$(jq -r ".resources.${k%%:*}.remaining // empty" <<<"$rl" 2>/dev/null || true)"
        lim="$(jq -r ".resources.${k%%:*}.limit // empty" <<<"$rl" 2>/dev/null || true)"
        rs="$(jq -r ".resources.${k%%:*}.reset // empty" <<<"$rl" 2>/dev/null || true)"
        [[ "$rem" =~ ^[0-9]+$ ]] && (( rem < ${COS_GH_MIN_REMAINING:-100} )) \
          && why+=("GitHub's ${k#*:} rate limit is nearly spent: $rem of ${lim:-?} calls left (the floor is ${COS_GH_MIN_REMAINING:-100}), resets at $(date -r "${rs:-0}" +%H:%M 2>/dev/null || echo '?')")
      done
    fi
  fi
  if [[ -n "$day" ]]; then
    f="$(find "$COS/zoom" -type f \( -name '*.txt' -o -name '*.vtt' -o -name '*.md' \) \
          \( -path "*$day*" -o -path "*${day//-/}*" -o \( -newermt "$day" ! -newermt "$day 23:59:59" \) \) -print -quit 2>/dev/null || true)"
    [[ -n "$f" ]] || why+=("no Zoom transcript for $day in ~/cos/zoom yet (ZoomMirror copies them from ~/Documents/Zoom)")
  fi
  [[ ${#why[@]} -eq 0 ]] && return 0
  out="$(printf '%s; ' "${why[@]}")"; pf_mask "${out%; }"; return 1
}
pf_conn() {  # $1 lane, $2 job id. Prints a warning (never a block) when a lane that uses the Sheets connector can't see it.
  local out
  [[ "$1" == apply-sheet || ( "${2:-}" == sheet-* && "$1" =~ ^(investigate|atlas|draft|build|eval)$ ) ]] || return 0
  out="$(perl -e 'alarm shift; exec @ARGV' "${COS_PREFLIGHT_MCP_SECS:-45}" claude mcp list 2>/dev/null || true)"
  if [[ -n "$out" ]] && ! grep -i "Google Sheets" <<<"$out" | grep -i 'connected' | grep -qviE 'fail|not connected|needs'; then
    echo "the Google Sheets connector may not be attached (claude mcp list doesn't show it connected); a warning only, the job ran"
  fi
  return 0
}
PF_NOTE=""
pf_run() {  # $1 lane, $2 receipt file name. A lane that can't run gets a receipt saying why, and stops before the model.
  local why rf="$COS/outbox/$JOB/${2:-receipt.json}"
  if why="$(preflight "$1" "$JOB")"; then
    PF_NOTE="$(pf_conn "$1" "$JOB")"   # the lane's receipt carries it as .preflight
    [[ -z "$PF_NOTE" ]] || ledger preflight job="$JOB" lane="$1" status=warn reason="$PF_NOTE"
    return 0
  fi
  ledger preflight job="$JOB" lane="$1" status=blocked reason="$why"
  mkdir -p "$(dirname "$rf")"
  jq -n --arg j "$JOB" --arg l "$1" --arg w "$why" '{job: $j, lane: $l, cost_usd: 0, preflight: {status: "blocked", reason: $w},
    receipt: {status: "blocked_preflight", verdict: "INCONCLUSIVE", summary: ("Nothing ran: " + $w + ". No model was called. Fix that, then rerun.")}}' > "$rf"
  echo "$rf"; cat "$rf"; async_done "$rf"; exit 0
}

# ---------------------------------------------------------------- receipt: a job's result, instantly, no model
# cos-run receipt <job>   Prints the receipt when the job has finished, or says it is still running or didn't finish.
# For an async eval, the job is eval-<suite>.
if [[ "$LANE" == "receipt" ]]; then
  [[ "$JOB" =~ ^[a-z0-9][a-z0-9._-]{0,60}$ ]] || usage_fail receipt "bad job id '$JOB'"
  D="$COS/outbox/$JOB"
  if [[ -f "$D/.running" ]]; then
    pid="$(cat "$D/.running")"
    if kill -0 "$pid" 2>/dev/null; then
      jq -n --arg j "$JOB" --arg since "$(stat -f '%Sm' -t '%H:%M' "$D/.running")" '{job: $j, status: "running", since: $since, note: "Still working. The result is pushed to the Chief when it finishes."}'; exit 0
    fi
    # The process is gone and left no receipt: a restart, a crash or a kill. Say so plainly and offer the same call again.
    again="$(cat "$D/.cmd" 2>/dev/null | sed -e "s#^[^ ]*/cos-run #cos-run #" -e 's/ *$//')"
    jq -n --arg j "$JOB" --arg again "$again" --arg tail "$(tail -c 1500 "$D/async.log" 2>/dev/null)" \
      '{job: $j, status: "interrupted", receipt: {status: "interrupted", verdict: "INCONCLUSIVE",
        summary: ("Didn'"'"'t finish: the job stopped before writing a receipt (the Mac may have restarted, or the job was killed). Rerun?" + (if $again != "" then " " + $again else "" end))},
        rerun: (if $again != "" then $again else null end), log_tail: $tail}'; exit 1
  fi
  # A call that was interrupted while it waited (see "Survive an interrupted call"): running, or what it printed.
  for f in "$COS"/state/runs/*-"$JOB".pid; do
    [[ -f "$f" ]] && kill -0 "$(cat "$f")" 2>/dev/null && { jq -n --arg j "$JOB" --arg l "$(basename "$f" "-$JOB.pid")" '{job: $j, lane: $l, status: "running", note: "Still finishing after the call was interrupted. Ask again in a minute; never run it again."}'; exit 0; }
  done
  for f in "$COS"/state/runs/*-"$JOB".out; do
    [[ -f "$f" ]] || continue; l="$(basename "$f" "-$JOB.out")"
    [[ -f "${f%.out}.pid" ]] || continue  # the waiter cleaned up: it already showed this output
    jq -n --arg j "$JOB" --arg l "$l" --arg o "$(tail -c 6000 "$f")" --arg e "$(tail -c 1500 "${f%.out}.err" 2>/dev/null)" \
      '{job: $j, lane: $l, status: "finished after an interrupted call", output: $o, errors: $e}'
    [[ "$l" == apply && -f "$D/apply-receipt.json" ]] && cat "$D/apply-receipt.json"
    exit 0
  done
  [[ -f "$D/receipt.json" ]] && { cat "$D/receipt.json"; exit 0; }
  jq -n --arg j "$JOB" '{job: $j, status: "not found"}'; exit 66
fi

# ---------------------------------------------------------------- --async: start a long job in the background
# Grok's terminal call can give up before a 2-5 minute job finishes. With --async the command returns in a second,
# the job runs detached, and its receipt is pushed to the Chief's webhook when it's done (if that key exists).
# Check any time with: cos-run receipt <job>
if [[ $ASYNC -eq 1 ]]; then
  [[ "$LANE" =~ ^(investigate|atlas|gh-scan|draft|build|eval|fix|land|lake)$ ]] || usage_fail "$LANE" "--async is for investigate, atlas, gh-scan, draft, build, eval, fix, land and lake; this lane answers at once"
  # ---------------------------------------------------------------- eval: blinded A/B on a fixed suite
# cos-run eval <suite> current|<variant.md>
# Runs every case in ~/cos/evals/<suite>.json through the investigate lane with the current lane prompt and, if given,
# a proposed one. Job ids are neutral, so the agent doesn't know it's being tested. One judge from a different model
# family scores both arms in a single pass, by shuffled label, against each case's rubric. A change is promoted only if
# it scores at least as well, breaks no must-not, and keeps the checker pass rate.
if [[ "$LANE" == "eval" ]]; then
  SUITE="$COS/evals/$JOB.json"; VARIANT="$BRIEF_IN"
  [[ -f "$SUITE" ]] || { echo "no suite at $SUITE" >&2; exit 66; }
  [[ "$VARIANT" == current || -f "$VARIANT" ]] || { echo "second argument: 'current' or a proposed lane prompt file" >&2; exit 64; }
  N="$(jq '.cases | length' "$SUITE")"; [[ "$N" -ge 1 && "$N" -le 8 ]] || { echo "a suite holds 1 to 8 cases" >&2; exit 64; }
  JOB="eval-$JOB" pf_run eval   # before any case or the judge; a block lands in eval-<suite>, where cos-run receipt looks
  RUN="$COS/evals/runs/$JOB-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$RUN"
  ARMS=(current); [[ "$VARIANT" != current ]] && { cp "$VARIANT" "$RUN/variant.md"; ARMS+=(variant); }
  echo "eval $JOB: $N cases x ${#ARMS[@]} arm(s). Expect about \$$(( N * ${#ARMS[@]} * 4 )) at most." >&2
  for arm in "${ARMS[@]}"; do
    for i in $(seq 0 $((N - 1))); do
      id="w$(openssl rand -hex 4)"; brief="$(jq -r ".cases[$i].brief" "$SUITE")"
      if [[ "$arm" == variant ]]; then COS_LANE_PROMPT="$RUN/variant.md" "$0" investigate "$id" "$brief" >/dev/null 2>&1 || true
      else "$0" investigate "$id" "$brief" >/dev/null 2>&1 || true; fi
      jq -nc --arg arm "$arm" --argjson i "$i" --arg job "$id" '{arm: $arm, case: $i, job: $job}' >> "$RUN/runs.jsonl"
    done
  done
  # Blind labels: a coin decides whether "current" is X or Y.
  if (( RANDOM % 2 )); then XA=current; YA=variant; else XA=variant; YA=current; fi
  [[ ${#ARMS[@]} -eq 1 ]] && XA=current
  receipt_of() { local j; j="$(jq -r --arg a "$1" --argjson i "$2" 'select(.arm == $a and .case == $i) | .job' "$RUN/runs.jsonl")"
                 jq -c '{status: .receipt.status, summary: .receipt.summary, evidence: .receipt.evidence, decisions: .receipt.decisions,
                        needs_approval: .receipt.needs_approval, artifacts: .receipt.artifacts}' "$COS/outbox/$j/receipt.json" 2>/dev/null | head -c 7000 || echo '{"status":"no receipt"}'; }
  JUDGE_IN="$RUN/judge-input.md"; : > "$JUDGE_IN"
  for i in $(seq 0 $((N - 1))); do
    { echo "## Case $i"; echo "Request: $(jq -r ".cases[$i].brief" "$SUITE")"
      echo "Rubric (score 0-5, 5 = every point met):"; jq -r ".cases[$i].rubric[] | \"- \" + ." "$SUITE"
      echo "Must not (any one is a violation):"; jq -r "(.cases[$i].must_not // [])[] | \"- \" + ." "$SUITE"
      echo "### Output X"; receipt_of "$XA" "$i"
      [[ ${#ARMS[@]} -eq 2 ]] && { echo "### Output Y"; receipt_of "$YA" "$i"; }
      echo; } >> "$JUDGE_IN"
  done
  agent -p --mode ask --trust --model gpt-5.3-codex-high --output-format json \
"You are grading the work of an assistant. Score each output against its case's rubric only, on one scale, in one pass.
Judge the output's substance and evidence, not its length. A must-not that occurred is a violation even if the score is high.
Return ONLY this JSON, no prose, no code fence:
{\"cases\":[{\"case\":0,\"X\":{\"score\":0,\"violations\":[\"...\"],\"note\":\"one line\"},\"Y\":{\"score\":0,\"violations\":[],\"note\":\"\"}}]}
Omit Y when a case has no Output Y.

$(cat "$JUDGE_IN")" > "$RUN/judge.json" 2> "$RUN/judge.err" || true
  jq -r '.result // ""' "$RUN/judge.json" | sed -e 's/^```[a-z]*//' -e 's/```$//' > "$RUN/judge-scores.json"
  jq -n --arg xa "$XA" --arg ya "$YA" --slurpfile s "$RUN/judge-scores.json" --arg run "$RUN" '
    def arm_of($l): if $l == "X" then $xa else $ya end;
    ($s[0].cases // []) as $c
    | [ $c[] | ("X","Y") as $l | select(.[$l] != null) | {arm: arm_of($l), case: .case, score: .[$l].score, violations: .[$l].violations, note: .[$l].note} ] as $rows
    | {run: $run, judge: "gpt-5.3-codex-high (different family from the worker)",
       arms: ([ $rows | group_by(.arm)[] | {arm: .[0].arm, mean_score: ((map(.score) | add) / length), violations: (map(.violations | length) | add)} ]),
       rows: $rows,
       rule: "promote the variant only if its mean_score >= current, violations == 0, and the checker pass rate (in each job receipt) is not lower"}' \
     > "$RUN/report.json" 2>/dev/null || echo '{"error":"judge output did not parse; see judge.json"}' > "$RUN/report.json"
  for arm in "${ARMS[@]}"; do
    pass="$(jq -r --arg a "$arm" 'select(.arm == $a) | .job' "$RUN/runs.jsonl" | while read -r j; do jq -r '.checker.verdict // "none"' "$COS/outbox/$j/receipt.json" 2>/dev/null; done | grep -c '^pass$' || true)"
    cost="$(jq -r --arg a "$arm" 'select(.arm == $a) | .job' "$RUN/runs.jsonl" | while read -r j; do jq -r '.cost_usd // 0' "$COS/outbox/$j/receipt.json" 2>/dev/null; done | paste -sd+ - | bc 2>/dev/null || echo 0)"
    jq --arg a "$arm" --argjson p "${pass:-0}" --argjson n "$N" --arg c "$cost" '.checker_pass = ((.checker_pass // {}) + {($a): "\($p)/\($n)"}) | .cost_usd = ((.cost_usd // {}) + {($a): $c})' \
      "$RUN/report.json" > "$RUN/report.tmp" && mv "$RUN/report.tmp" "$RUN/report.json"
  done
  if [[ "${COS_ASYNC_CHILD:-}" == 1 ]]; then
    jq --arg j "eval-$JOB" '{job: $j, lane: "eval", receipt: {status: "done", summary: ("Eval report: " + ([.arms[]? | "\(.arm) mean \(.mean_score), violations \(.violations)"] | join("; ")))}, report: .}' "$RUN/report.json" > "$COS_ASYNC_DIR/receipt.json"
    async_done "$COS_ASYNC_DIR/receipt.json"
  fi
  echo "$RUN/report.json"; cat "$RUN/report.json"; exit 0
fi

[[ "$JOB" =~ ^[a-z0-9][a-z0-9._-]{0,60}$ ]] || usage_fail "$LANE" "bad job id '$JOB': lowercase letters, digits, dot, dash, underscore"
  AJ="$JOB"; [[ "$LANE" == eval ]] && AJ="eval-$JOB"
  D="$COS/outbox/$AJ"; mkdir -p "$D"
  if [[ -f "$D/.running" ]] && kill -0 "$(cat "$D/.running")" 2>/dev/null; then
    jq -n --arg j "$AJ" '{job: $j, status: "already running", check_with: "cos-run receipt \($j)"}'; exit 0
  fi
  # A fix or land job keeps its receipt: land reads it, and fix refuses to reuse a job id anyway.
  [[ -f "$D/receipt.json" && ! "$LANE" =~ ^(fix|land)$ ]] && mv "$D/receipt.json" "$D/receipt.prev.json"
  REST=(); for a in "${ALL_ARGS[@]}"; do [[ "$a" == "--async" ]] || REST+=("$a"); done
  # A new session, so the job survives the caller's terminal closing.
  COS_ASYNC_CHILD=1 COS_ASYNC_DIR="$D" nohup perl -e 'use POSIX qw(setsid); setsid(); exec @ARGV' "$0" "${REST[@]}" > "$D/async.log" 2>&1 < /dev/null &
  echo $! > "$D/.running"; words "$0" "${ALL_ARGS[@]}" > "$D/.cmd"
  jq -n --arg j "$AJ" --arg l "$LANE" '{job: $j, lane: $l, status: "started", note: "Running in the background. The receipt is pushed to the Chief when it finishes.", check_with: "cos-run receipt \($j)"}'
  exit 0
fi
async_done() {  # in a background job: clear the marker and push the receipt to the Chief
  [[ "${COS_ASYNC_CHILD:-}" == 1 ]] || return 0
  rm -f "${COS_ASYNC_DIR:?}/.running"
  "$HOME/cos/bin/cos-push" chief result "$1" >/dev/null 2>>"${COS_ASYNC_DIR}/async.log" \
    || echo "not pushed to the Chief (no cos-webhook-chief key, or the push failed). Use: cos-run receipt" >> "${COS_ASYNC_DIR}/async.log"
}

# ---------------------------------------------------------------- note: capture a correction, no model
# Every correction Cassidy makes to a bot or an agent lands here. KEEPER reads this file every week.
# One-offs stay one-offs; the same mistake twice becomes a fix (a check, a skill edit, a rule), proposed and evaluated.
if [[ "$LANE" == "note" ]]; then
  BOT="$JOB"
  [[ "$BOT" =~ ^(chief|ops|steward|builder|keeper|claude|cursor|cos-run)$ ]] || { echo "bot: chief|ops|steward|builder|keeper|claude|cursor|cos-run" >&2; exit 64; }
  [[ ${#BRIEF_IN} -le 600 ]] || { echo "keep a note under 600 characters" >&2; exit 64; }
  mkdir -p "$COS/state"
  jq -nc --arg t "$(date -u +%FT%TZ)" --arg b "$BOT" --arg n "$BRIEF_IN" '{at: $t, bot: $b, note: $n}' >> "$COS/state/corrections.jsonl"
  ledger corrections bot="$BOT" note="$BRIEF_IN"
  echo "noted ($(wc -l < "$COS/state/corrections.jsonl" | tr -d ' ') corrections on file)"; exit 0
fi

# ---------------------------------------------------------------- pause: hold a scheduled slot for N days, no model
# cos-run pause <slot|all> <days>   (0 resumes). cos-sched skips the slot silently until the date passes.
if [[ "$LANE" == "pause" ]]; then
  SLOT_P="$JOB"; DAYS_P="$BRIEF_IN"
  [[ "$SLOT_P" =~ ^(all|followups|pulse|reconcile|capture|week|opportunity|keeper)$ ]] || { echo "slot: all|followups|pulse|reconcile|capture|week|opportunity|keeper" >&2; exit 64; }
  [[ "$DAYS_P" =~ ^[0-9]{1,3}$ ]] || { echo "days: a whole number, 0 to resume" >&2; exit 64; }
  mkdir -p "$COS/state"
  if [[ "$DAYS_P" -eq 0 ]]; then rm -f "$COS/state/pause-$SLOT_P"; ledger pauses slot="$SLOT_P" days=0 until=""; echo "resumed: $SLOT_P"; exit 0; fi
  UNTIL="$(date -v+"${DAYS_P}"d +%F)"; echo "$UNTIL" > "$COS/state/pause-$SLOT_P"
  ledger pauses slot="$SLOT_P" days="$DAYS_P" until="$UNTIL"
  echo "paused: $SLOT_P through $UNTIL (resume early with: cos-run pause $SLOT_P 0)"; exit 0
fi

# ---------------------------------------------------------------- preflight: the same check by hand, no model, no receipt
# cos-run preflight <lane> [job]   Exit 0 and "ok" when the lane could run now; exit 1 and the reason when it couldn't.
if [[ "$LANE" == preflight ]]; then
  why="$(preflight "$JOB" "$BRIEF_IN")" && rc=0 || rc=$?
  [[ $rc -eq 2 ]] && usage_fail preflight "$why"
  warn=""; [[ $rc -eq 0 ]] && warn="$(pf_conn "$JOB" "$BRIEF_IN")"
  jq -n --arg l "$JOB" --arg j "$BRIEF_IN" --arg w "$why" --arg n "$warn" '{lane: $l, job: $j, preflight: (if $w == "" then "ok" else "blocked" end)}
    + (if $w == "" then {} else {reason: $w} end) + (if $n == "" then {} else {warning: $n} end)'
  exit $(( rc == 0 ? 0 : 1 ))
fi

[[ "$JOB" =~ ^[a-z0-9][a-z0-9._-]{0,60}$ ]] || usage_fail "$LANE" "bad job id '$JOB': lowercase letters, digits, dot, dash, underscore, up to 61 characters"
case "$LANE" in investigate|atlas|draft|build|fix|lake) long_lane ;; esac

# gh-scan: one read-only GitHub pass (claude/cos-gh-scan), a script with no model in it. The Chief runs it for every brief.
if [[ "$LANE" == gh-scan ]]; then
  OUT="$COS/outbox/$JOB"; mkdir -p "$OUT"
  "$COS/bin/cos-gh-scan" "$OUT" ${BRIEF_IN:+"$BRIEF_IN"} ${SCAN_STATE:+--state "$SCAN_STATE"} > "$OUT/run.out" 2> "$OUT/run.err" || true
  [[ -f "$OUT/receipt.json" ]] || jq -n --arg j "$JOB" --arg e "$(tail -c 300 "$OUT/run.err" 2>/dev/null)" \
    '{job: $j, lane: "gh-scan", receipt: {status: "failed", summary: ("GitHub read failed: the scan crashed. " + $e)}}' > "$OUT/receipt.json"
  cat "$OUT/receipt.json"; async_done "$OUT/receipt.json"; exit 0
fi

# atlas: an investigate job with the Agent Atlas brief and read-only access to Atlas and the transcripts it indexes.
