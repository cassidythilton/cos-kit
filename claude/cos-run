  [[ "$GUARD" == ok && "$TESTS" == pass && "$(jq -r .verdict <<<"$VERDICT")" == pass ]] || { STATUS=blocked; READY=false; }
  SUMMARY="$( { sed -n '1,12p' "$OUT/fix.md" 2>/dev/null || true; } | cut -c1-600)"; [[ -n "$SUMMARY" ]] || SUMMARY="The fixer wrote no fix.md."
  [[ "$STATUS" == blocked ]] && SUMMARY="Needs you: $(jq -r '.ask // .failures[0] // "the review blocked this fix"' <<<"$VERDICT")$([[ "$TESTS" == pass ]] || echo " Tests: ${FP:-?} passed, ${FF:-?} failed.")

$SUMMARY"
  fix_receipt --arg j "$JOB" --arg s "$STATUS" --arg sum "$SUMMARY" --arg sha "$SHA" --arg base "$BASE" --arg br "$BR" \
    --argjson ready "$READY" --argjson control "$CONTROL" --arg guard "$GUARD" --arg tests "${FP:-?} passed, ${FF:-?} failed (base: ${BP:-?} passed, ${BF:-?} failed)" \
    --arg files "$FILES" --argjson verdict "$VERDICT" --argjson c "${COST:-0}" --arg so "$(jq -r '.result // empty' "$OUT/second-opinion.json" 2>/dev/null | head -c 1500)" --argjson rev "${REVISION:-null}" \
    '{job: $j, lane: "fix", receipt: {status: $s, summary: $sum, cost_usd: $c,
      control_change: $control, files: ($files|split("\n")|map(select(length>0))), tests: $tests, fix_lane_untouched: ($guard == "ok"),
      second_opinion: $so, checker: $verdict, diff: "fix.diff", revision: $rev,
      needs_approval: (if $ready then ["Land fix \($j): read fix.diff\(if $control then " IN FULL: it changes a control (the gate, permissions, apply rules or the installer)" else "" end), then say yes to sha256 \($sha)"] else [] end)},
      fix: {base: $base, branch: $br, sha256: $sha},
      approve_with: (if $ready then "cos-run land \($j) \($sha)" else null end)}'
