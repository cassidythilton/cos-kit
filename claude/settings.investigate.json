      "Bash(board-pulse*)",
      "Bash(gh project field-list *)",
      "Bash(gh search prs *)",
      "Bash(make roadmap-check*)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(*EXECUTE=1*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env*)",
      "WebFetch",
      "WebSearch"
