      "Bash(make stale*)",
      "Bash(make weed*)",
      "Bash(make ship-check)",
      "Bash(make raqs)",
      "Bash(make socialize)",
      "Bash(make gate)",
      "Bash(make lint-writing*)",
      "Bash(make selftest)",
      "Bash(make doctor)",
      "Bash(make query *)",
      "Bash(make next-id*)",
      "Bash(make next-raq*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh project item-list *)",
      "Bash(gh project view *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(DRY_RUN=1 make *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(date *)",
      "mcp__claude_ai_Google_Sheets__get_values",
      "mcp__claude_ai_Google_Sheets__get_spreadsheet",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__claude_ai_Slack__slack_read_canvas",
