#!/usr/bin/env -S python3 -I
"""cos-diligence: BUILDER's two-model diligence (plan 2026-11-14, last section; Cassidy's decisions 1b, 2c, 3a, Nov 15).

  cos-diligence <job folder>            run every step after Claude's opportunity pass (cos-run calls this)
  cos-diligence compare <job folder>    redo the comparison from the saved passes (no model)
  cos-diligence verdict <job folder>    redo the verdict and BUILDER's receipt from the saved files (no model)

Steps, in order. Each runs only if the $30 cap (COS_DILIGENCE_CAP) still covers it; a step that doesn't fit is
listed as not run, and so is every step after it.
  1. Claude's pass (done before this, in cos-run's investigate lane): opportunities.md, diligence.json, slack-digest.md.
  2. Codex's blind pass over the same candidates (card and one-line idea only, never Claude's statuses or evidence).
     Codex works in <job>/codex/ws, walled by claude/codex/cli.json and claude/cursor-codex-hook: reads only that
     workspace and ~/cos/data-org-main, GitHub reads only, no writes, no other shell, no web. Before anything is
     copied in, the canon tripwire checks it; a hit holds that file on the Mac and the receipt says so. Transcripts
     never go to Codex: evidence Claude cites from a call is replaced by "held on the Mac" before Codex sees it.
  3. Comparison (this script): card by card, agree CHECKED, agree out (agree DEAD when both say DEAD), or disagree.
  4. Cross-examination, one round each: Claude attacks Codex's CHECKED ideas and Codex attacks Claude's; then each
     side may concede or defend once, with citations.
  5. Verdict (this script): survives only if both end CHECKED and nothing stands refuted. A live dispute is contested
     (Cassidy sees both arguments). Everything else is out, with its reason.
  6. BUILDER's receipt: builder.md and receipt.json's "diligence" block. Survivors and contested ideas, labeled, with
     each model's score line and the models' consensus order as advice. BUILDER ranks loosely (2c) and can't promote
     an idea that's out.
Never posts, never writes outside the job folder, never touches a card.
"""
import json, os, re, shutil, subprocess, sys, time
from datetime import datetime, timedelta

HOME = os.path.expanduser("~")
COS = os.path.join(HOME, "cos")
CAP = float(os.environ.get("COS_DILIGENCE_CAP", "30"))
CODEX_MODEL = "gpt-5.3-codex-high"
# Codex runs through the Cursor CLI, which reports tokens, not dollars. Cost is estimated at OpenAI's list price for
# the GPT-5 codex models ($ per million tokens). Cursor bills its own plan; this is for the cap, and labeled an estimate.
PRICE = {"in": 1.75, "cache": 0.175, "out": 14.0}
CODEX_RESERVE = {"codex-pass": 4.0, "codex-attack": 2.0, "codex-respond": 1.5}  # needed before a Codex step starts
CLAUDE_BUDGET = {"claude-attack": 3.0, "claude-respond": 1.5}                   # --max-budget-usd for Claude steps
CODEX_TIMEOUT = int(os.environ.get("COS_CODEX_TIMEOUT", "1800"))
STEP_ORDER = ["codex-pass", "claude-attack", "codex-attack", "claude-respond", "codex-respond"]
STATUSES = ["CHECKED", "OFFER", "DEAD", "NOT CHECKED YET"]
CANON_RE = re.compile(r"canon_ingredient|canon_term|canon_assets\.|food_expression_ingredients|mirror\.canon_|history\.canon_|mart\.canon_", re.I)
# Anything that points at a call: the transcript folders, the word, a .txt/.vtt call file, or a call timestamp.
TRANSCRIPT_RE = re.compile(r"cos/zoom|/meetings/|transcript|\.vtt\b|check-in\.txt|\b\d{1,2}:\d{2}:\d{2}\b|\[\d{1,2}:\d{2}", re.I)
HELD_EVIDENCE = "[evidence from a call transcript, held on the Mac]"


# ------------------------------------------------------------------ small helpers
def load(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def save(path, obj):
    with open(path + ".tmp", "w") as f:
        json.dump(obj, f, indent=2)
    os.replace(path + ".tmp", path)


def norm_status(s):
    s = (s or "").strip().upper()
    return s if s in STATUSES else "NOT CHECKED YET"


def extract_json(text, key):
    """The last {"<key>": ...} object in a reply. Codex sometimes opens with a sentence, or wraps it in a fence."""
    if isinstance(text, dict):
        return text if key in text else None
    text = text or ""
    for m in reversed(list(re.finditer(r'\{\s*"' + re.escape(key) + r'"', text))):
        try:
            obj = json.JSONDecoder().raw_decode(text[m.start():])[0]
            if isinstance(obj, dict) and isinstance(obj.get(key), list):
                return obj
        except Exception:
            continue
    return None


def codex_safe(s):
    """Text bound for Codex: canon text is held, call evidence is held. Returns (text, held_reason or None)."""
    s = "" if s is None else str(s)
    if CANON_RE.search(s):
        return "[held on the Mac: names a canon table]", "canon"
    if TRANSCRIPT_RE.search(s):
        return HELD_EVIDENCE, "transcript"
    return s, None


# ------------------------------------------------------------------ the run's ledger and the cap
class Run:
    def __init__(self, out):
        self.out = out
        self.state_path = os.path.join(out, "diligence-steps.json")
        st = load(self.state_path, {}) or {}
        self.steps = st.get("steps", {})
        self.claude_pass = st.get("claude_pass") or self.claude_pass_cost()
        self.held = st.get("held", [])
        self.capped = False

    def claude_pass_cost(self):
        r = load(os.path.join(self.out, "receipt.json"), {}) or {}
        c = float(r.get("cost_usd") or 0)          # the pass, plus its revision round when one ran
        for f in ("checker.json", "checker.round1.json"):
            c += float((load(os.path.join(self.out, f), {}) or {}).get("total_cost_usd") or 0)
        return round(c, 4)

    def spent(self):
        return round(self.claude_pass + sum(float(s.get("cost_usd") or 0) for s in self.steps.values()), 4)

    def remaining(self):
        return round(CAP - self.spent(), 4)

    def record(self, name, **kw):
        self.steps[name] = {**self.steps.get(name, {}), **kw}
        self.persist()

    def hold(self, what, why):
        if not any(h["what"] == what for h in self.held):
            self.held.append({"what": what, "why": why})
        self.persist()

    def persist(self):
        save(self.state_path, {"cap_usd": CAP, "claude_pass": self.claude_pass, "steps": self.steps, "held": self.held})


def codex_cost(usage):
    u = usage or {}
    return round((u.get("inputTokens", 0) * PRICE["in"] + u.get("cacheReadTokens", 0) * PRICE["cache"]
                  + u.get("outputTokens", 0) * PRICE["out"]) / 1e6, 4)


# ------------------------------------------------------------------ the two engines
def codex_ws(out):
    ws = os.path.join(out, "codex", "ws")
    os.makedirs(os.path.join(ws, ".cursor"), exist_ok=True)
    shutil.copy(os.path.join(COS, "claude", "codex", "cli.json"), os.path.join(ws, ".cursor", "cli.json"))
    with open(os.path.join(ws, ".cursor", "hooks.json"), "w") as f:
        json.dump({"version": 1, "hooks": {"preToolUse": [{"command": os.path.join(COS, "claude", "cursor-codex-hook")}]}}, f)
    return ws


def start_codex(run, name, prompt):
    ws = codex_ws(run.out)
    os.makedirs(os.path.join(run.out, "codex"), exist_ok=True)
    with open(os.path.join(run.out, "codex", name + ".prompt.md"), "w") as f:
        f.write(prompt)   # exactly what went to Codex, for audit
    cmd = ["agent", "-p", "--trust", "--model", CODEX_MODEL, "--output-format", "json"]
    if os.path.isdir(os.path.join(COS, "data-org-main")):
        cmd += ["--add-dir", os.path.join(COS, "data-org-main")]
    cmd.append(prompt)
    return subprocess.Popen(cmd, cwd=ws, stdout=open(os.path.join(run.out, "codex", name + ".raw.json"), "w"),
                            stderr=open(os.path.join(run.out, "codex", name + ".err"), "w"))


def finish_codex(run, name, proc, key):
    try:
        proc.wait(timeout=CODEX_TIMEOUT)
    except subprocess.TimeoutExpired:
        proc.kill()
        run.record(name, status="failed", why=f"timed out after {CODEX_TIMEOUT}s", cost_usd=CODEX_RESERVE[name], cost_note="reserve counted: no usage reported")
        return None
    raw = load(os.path.join(run.out, "codex", name + ".raw.json"), {}) or {}
    usage = raw.get("usage")
    cost = codex_cost(usage) if usage else CODEX_RESERVE[name]
    obj = extract_json(raw.get("result", ""), key)
    run.record(name, status="ran" if obj else "failed", engine="codex", model=CODEX_MODEL, cost_usd=cost,
               cost_note="estimate from tokens at list price" if usage else "reserve counted: no usage reported",
               chat=raw.get("session_id", ""), why="" if obj else "Codex returned no usable JSON (see codex/" + name + ".err)")
    if obj:
        save(os.path.join(run.out, "codex", name + ".json"), obj)
    return obj


def start_claude(run, name, prompt, schema, budget):
    os.makedirs(os.path.join(run.out, "claude"), exist_ok=True)
    adds = [run.out, os.path.join(COS, "handbook"), os.path.join(HOME, "meetings")]
    for d in ("zoom", "data-org-main", "notebook-main", "outbox", "state"):
        if os.path.isdir(os.path.join(COS, d)):
            adds.append(os.path.join(COS, d))
    cmd = ["claude", "-p", prompt, "--settings", os.path.join(COS, "claude", "settings.investigate.json"),
           "--permission-mode", "dontAsk", "--permission-prompts", "none", "--add-dir", *adds,
           "--model", "opus", "--effort", "medium", "--max-budget-usd", f"{budget:.2f}", "--no-session-persistence",
           "--output-format", "json", "--json-schema", json.dumps(schema)]
    wd = os.path.join(COS, "data-org-main") if os.path.isdir(os.path.join(COS, "data-org-main")) else run.out
    return subprocess.Popen(cmd, cwd=wd, stdout=open(os.path.join(run.out, "claude", name + ".json"), "w"),
                            stderr=open(os.path.join(run.out, "claude", name + ".err"), "w"))


def finish_claude(run, name, proc, key, budget):
    try:
        proc.wait(timeout=CODEX_TIMEOUT)
    except subprocess.TimeoutExpired:
        proc.kill()
        run.record(name, status="failed", why="timed out", cost_usd=budget, cost_note="budget counted")
        return None
    raw = load(os.path.join(run.out, "claude", name + ".json"), {}) or {}
    obj = raw.get("structured_output")
    if not isinstance(obj, dict):
        obj = extract_json(raw.get("result", ""), key)
    ok = isinstance(obj, dict) and isinstance(obj.get(key), list)
    cost = raw.get("total_cost_usd")
    run.record(name, status="ran" if ok else "failed", engine="claude", model="opus",
               cost_usd=float(cost) if cost is not None else budget,
               cost_note="" if cost is not None else "budget counted: no cost reported",
               why="" if ok else "Claude returned no usable JSON (see claude/" + name + ".err)")
    return obj if ok else None


def fits(run, name):
    """Can this step start under the cap? Steps after one that didn't fit don't run either."""
    need = CODEX_RESERVE.get(name) or 1.0   # a Claude step needs at least $1 to be worth starting
    if run.capped:
        run.record(name, status="not run", why=f"the ${CAP:.0f} cap stopped an earlier step", cost_usd=0)
        return False
    if run.remaining() < need:
        run.capped = True
        run.record(name, status="not run", why=f"the ${CAP:.0f} cap: ${run.spent():.2f} spent, ${run.remaining():.2f} left, this step needs ${need:.2f}", cost_usd=0)
        return False
    return True


