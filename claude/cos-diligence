def render_entry(e, for_codex):
    out = [f"### id {e['id']} · status {e.get('status')} · {('rank ' + str(e['rank'])) if e.get('rank') else ''}".rstrip(" ·"),
           f"Reason: {codex_safe(e.get('reason'))[0] if for_codex else e.get('reason', '')}"]
    if e.get("score_line"):
        out.append(f"Score: {codex_safe(e['score_line'])[0] if for_codex else e['score_line']}")
    for ev in e.get("evidence", []) or []:
        if not isinstance(ev, dict):
            continue
        claim, cite = ev.get("claim", ""), ev.get("cite", "")
        if for_codex:
            if (ev.get("kind") or "").lower() == "transcript" or TRANSCRIPT_RE.search(f"{claim} {cite}"):
                claim, cite = HELD_EVIDENCE, "call transcript (held on the Mac)"
            else:
                claim, cite = codex_safe(claim)[0], codex_safe(cite)[0]
        out.append(f"- {ev.get('field', 'evidence')}: {claim} [{cite}]")
    return "\n".join(out)


