# ------------------------------------------------------------------ verdict (no model)
def decide(ids, cl, cx, att_cl, att_cx, resp_cx, resp_cl, steps):
    """att_cl: Claude's attacks on Codex's CHECKED; att_cx: Codex's on Claude's. resp_cx: Codex's replies to Claude's
    attacks; resp_cl: Claude's replies to Codex's. Returns one record per id."""
    def ran(s):
        return (steps.get(s) or {}).get("status") == "ran"
    res = []
    for i in ids:
        fin = {"claude": cl[i]["status"], "codex": cx[i]["status"]}
        why_of = {"claude": cl[i].get("reason", ""), "codex": cx[i].get("reason", "")}
        disputes, unexamined, log = [], [], []
        for attacker, defender, atk, rsp, astep, rstep in (("claude", "codex", att_cl, resp_cx, "claude-attack", "codex-respond"),
                                                            ("codex", "claude", att_cx, resp_cl, "codex-attack", "claude-respond")):
            mine = cl if defender == "claude" else cx
            if mine[i]["status"] != "CHECKED":
                continue
            a = atk.get(i)
            if a is None:
                st = steps.get(astep) or {}
                unexamined.append(f"{attacker} didn't cross-examine it ({astep} {st.get('status', 'not run')}{': ' + st['why'] if st.get('why') else ''})")
                continue
            if a.get("verdict") == "stands":
                fin[attacker] = "CHECKED"
                why_of[attacker] = "accepted the other model's case: " + a.get("reason", "")
                log.append(f"{attacker} tried to break {defender}'s case and couldn't: {a.get('reason', '')} [{a.get('cite', '')}]")
                continue
            r = rsp.get(i)
            prop = norm_status(a.get("proposed_status"))
            prop = prop if prop != "CHECKED" else "NOT CHECKED YET"
            if r and r.get("response") == "concede":
                fin[defender] = prop
                why_of[defender] = "conceded: " + (r.get("reason") or a.get("reason", ""))
                log.append(f"{attacker} refuted it ({a.get('reason', '')} [{a.get('cite', '')}]); {defender} conceded: {r.get('reason', '')}")
            else:
                disputes.append({"attacker": attacker, "attack": a.get("reason", ""), "attack_cite": a.get("cite", ""),
                                 "proposed_status": prop, "defender": defender,
                                 "defense": (r or {}).get("reason") or f"no reply ({rstep} {(steps.get(rstep) or {}).get('status', 'not run')})",
                                 "defense_cite": (r or {}).get("cite", "")})
        if unexamined:
            outcome, why = "out", "not cross-examined: " + "; ".join(unexamined)
        elif disputes:
            outcome, why = "contested", "; ".join(f"{d['attacker']} says {d['proposed_status']}: {d['attack']} / {d['defender']} defends: {d['defense']}" for d in disputes)
        elif fin["claude"] == fin["codex"] == "CHECKED":
            outcome, why = "survives", "both CHECKED, neither refuted"
        else:
            outcome = "out"
            why = f"Claude {fin['claude']}: {why_of['claude']} / Codex {fin['codex']}: {why_of['codex']}"
        res.append({"id": i, "outcome": outcome, "why": why, "final": fin, "passes": {"claude": cl[i]["status"], "codex": cx[i]["status"]},
                    "disputes": disputes, "cross_exam": log,
                    "score_lines": {"claude": cl[i].get("score_line", ""), "codex": cx[i].get("score_line", "")},
                    "ranks": {"claude": cl[i].get("rank"), "codex": cx[i].get("rank")}})
    return res


def consensus(records):
    keep = [r for r in records if r["outcome"] in ("survives", "contested")]
    def rk(r, m):
        v = r["ranks"].get(m)
        return v if isinstance(v, int) and v > 0 else len(keep) + 1
    keep.sort(key=lambda r: ((rk(r, "claude") + rk(r, "codex")) / 2, 0 if r["outcome"] == "survives" else 1, r["id"]))
    return [r["id"] for r in keep]


# ------------------------------------------------------------------ BUILDER's receipt
def write_receipt(run, d, cands, records, order, notes):
    out = run.out
    meta = {c["id"]: c for c in cands}
    label = {"survives": "SURVIVES", "contested": "CONTESTED", "out": "OUT"}
    surv = [r for r in records if r["outcome"] == "survives"]
    cont = [r for r in records if r["outcome"] == "contested"]
    outs = [r for r in records if r["outcome"] == "out"]
    claude_usd = run.claude_pass + sum(s.get("cost_usd", 0) for n, s in run.steps.items() if s.get("engine") == "claude")
    codex_usd = sum(s.get("cost_usd", 0) for n, s in run.steps.items() if s.get("engine") == "codex")
    notrun = [f"{n} ({s.get('why', '')})" for n, s in run.steps.items() if s.get("status") in ("not run", "failed")]
    name = lambda i: f"{meta[i].get('card') or i}: {meta[i].get('idea', '')}".strip()
    md = [f"# BUILDER: two-model diligence ({os.path.basename(out)}, window {d.get('window', '?')})", "",
          f"**{len(surv)} survive · {len(cont)} contested · {len(outs)} out.** Cost ${run.spent():.2f} of the ${CAP:.0f} cap "
          f"(Claude ${claude_usd:.2f}; Codex ≈${codex_usd:.2f}, estimated from tokens).", ""]
    if notes:
        md += ["Notes: " + " ".join(notes), ""]
    if notrun:
        md += ["Steps that didn't run or failed: " + "; ".join(notrun), ""]
    if run.held:
        md += ["Held on the Mac (not shown to Codex): " + "; ".join(f"{h['what']} ({h['why']})" for h in run.held), ""]
    md += ["## For BUILDER", "", "Rank survivors and contested ideas loosely (decision 2c). The order below is the models' consensus, as "
           "advice. An idea that's out can't be promoted. A contested idea needs Cassidy's call before it's built.", ""]
    for n, i in enumerate(order, 1):
        r = next(x for x in records if x["id"] == i)
        md += [f"{n}. [{label[r['outcome']]}] {name(i)}",
               f"   - Claude's score: {r['score_lines']['claude'] or '(not CHECKED by Claude)'}",
               f"   - Codex's score: {r['score_lines']['codex'] or '(not CHECKED by Codex)'}"]
        for line in r["cross_exam"]:
            md.append(f"   - {line}")
    if not order:
        md.append("Nothing survived or is contested this week. Fewer is a fine answer.")
    if cont:
        md += ["", "## Contested: both arguments, side by side", ""]
        for r in cont:
            md += [f"### {name(r['id'])}", "", "| | Claude | Codex |", "|---|---|---|",
                   f"| Own pass | {r['passes']['claude']} | {r['passes']['codex']} |"]
            for dsp in r["disputes"]:
                a, b = (dsp["attack"] + f" [{dsp['attack_cite']}]", dsp["defense"] + f" [{dsp['defense_cite']}]")
                row = (b, a) if dsp["attacker"] == "codex" else (a, b)
                md.append(f"| {dsp['attacker'].title()} attacks, {dsp['defender'].title()} replies | {row[0].replace('|', '/')} | {row[1].replace('|', '/')} |")
            md.append("")
    md += ["", "## Out", ""] + [f"- {name(r['id'])}: {r['why']}" for r in outs]
    for e in d.get("excluded", []) or []:
        md.append(f"- excluded: {e}")
    md += ["", "## How each model saw it", "", "| Card | Claude | Codex | Comparison | Verdict |", "|---|---|---|---|---|"]
    cmp_ = {c["id"]: c["category"] for c in (load(os.path.join(out, "compare.json"), {}) or {}).get("rows", [])}
    for r in records:
        md.append(f"| {meta[r['id']].get('card') or r['id']} | {r['passes']['claude']} | {r['passes']['codex']} | {cmp_.get(r['id'], '')} | {label[r['outcome']]} |")
    open(os.path.join(out, "builder.md"), "w").write("\n".join(md) + "\n")

    block = {"status": "done", "cap_usd": CAP, "spent_usd": run.spent(), "claude_usd": round(claude_usd, 4),
             "codex_usd_estimate": round(codex_usd, 4), "steps": run.steps, "held": run.held, "consensus_order": order,
             "records": records, "file": "builder.md"}
    save(os.path.join(out, "diligence-verdict.json"), block)
    lines = [f"Two-model diligence (Claude and Codex): {len(surv)} survive, {len(cont)} contested, {len(outs)} out. "
             f"Cost ${run.spent():.2f} of ${CAP:.0f}. BUILDER ranks only survivors and contested ideas; contested ones need Cassidy."]
    for i in order:
        r = next(x for x in records if x["id"] == i)
        lines.append(f"- [{label[r['outcome']]}] {name(i)}" + (f": {r['why']}" if r["outcome"] == "contested" else ""))
    for r in outs:
        lines.append(f"- [OUT] {meta[r['id']].get('card') or r['id']}: {r['why']}")
    if notrun:
        lines.append("Didn't run: " + "; ".join(notrun) + ".")
    if run.held:
        lines.append("Held on the Mac: " + "; ".join(h["what"] for h in run.held) + ".")
    summ = "\n".join(lines)
    if CANON_RE.search(summ):   # the receipt leaves the Mac for Grok
        summ = f"Two-model diligence: {len(surv)} survive, {len(cont)} contested, {len(outs)} out. Details held on the Mac (builder.md): they name a canon table."
    merge(out, block, summ)


def merge(out, block, summary):
    rp = os.path.join(out, "receipt.json")
    r = load(rp, {}) or {}
    r["diligence"] = {k: v for k, v in block.items() if k != "records"} | {"outcomes": {x["id"]: x["outcome"] for x in block.get("records", [])}}
    rc = r.setdefault("receipt", {})
    if "pass1_summary" not in r:   # Claude's own summary, kept once so a rerun of the verdict doesn't stack summaries
        r["pass1_summary"] = rc.get("summary") or ""
    # Claude's own summary ranks ideas before Codex and the cross-examination saw them. It stays for the record, labeled
    # as superseded, so neither BUILDER nor the Chief reads its "Ranked:" line as the verdict.
    p1 = r["pass1_summary"].strip()
    rc["summary"] = summary + ("\n\nClaude's single pass, before cross-examination (superseded by the verdict above; "
                               "its ranking is not BUILDER's):\n" + p1 if p1 else "")
    arts = rc.setdefault("artifacts", [])
    for f in ("builder.md", "diligence-verdict.json", "compare.json", "slack-digest.md"):
        p = os.path.join(out, f)
        if os.path.isfile(p) and p not in arts and f not in arts:
            arts.append(p)
    save(rp, r)


def skip_all(out, why):
    run = Run(out)
    for s in STEP_ORDER:
        run.record(s, status="not run", why=why, cost_usd=0)
    block = {"status": "skipped", "why": why, "cap_usd": CAP, "spent_usd": run.spent(), "steps": run.steps, "held": run.held}
    save(os.path.join(out, "diligence-verdict.json"), block)
    merge(out, block, f"Two-model diligence didn't run: {why}. Nothing from this pass can be ranked.")


# ------------------------------------------------------------------ the run
def main_run(out):
    out = os.path.abspath(out)
    if not os.path.isfile(os.path.join(out, "receipt.json")):
        print(f"cos-diligence: no receipt in {out}", file=sys.stderr); return 66
    r = load(os.path.join(out, "receipt.json"), {}) or {}
    if (r.get("checker") or {}).get("verdict") != "pass":
        skip_all(out, "the checker blocked Claude's pass"); return 0
    d, cands = claude_candidates(out)
    if not cands:
        skip_all(out, "Claude's pass wrote no diligence.json with candidates"); return 0
    run = Run(out)
    window = d.get("window") or os.environ.get("COS_DILIGENCE_WINDOW") or \
        f"{(datetime.now() - timedelta(days=8)):%Y-%m-%d} to {(datetime.now() - timedelta(days=1)):%Y-%m-%d}"
    cl = {c["id"]: c for c in cands}
    carded = [c for c in cands if c.get("card")]
    for c in cands:
        why = codex_safe(c.get("idea"))[1]
        if why and c.get("card"):
            run.hold(f"idea text for {c['card']}", "names a canon table" if why == "canon" else "points at a call transcript")

    # 2. Codex's blind pass
    cx_obj = None
    if carded and fits(run, "codex-pass"):
        ws = codex_ws(out)
        have = screen_into_ws(run, ws, window)
        with open(os.path.join(ws, "candidates.md"), "w") as f:
            f.write("\n".join(f"- id {c['id']}: card {c['card']}. Idea: {codex_safe(c.get('idea', ''))[0]}" for c in carded) + "\n")
        p = start_codex(run, "codex-pass", codex_pass_prompt(carded, have, window, run.held))
        cx_obj = finish_codex(run, "codex-pass", p, "candidates")
    elif not carded:
        run.record("codex-pass", status="not run", why="no candidate has a card", cost_usd=0)
    cx = pass_by_id(cx_obj, cands, "Codex")
    for c in cands:
        if not c.get("card"):
            cx[c["id"]]["reason"] = "needs a card first (Codex reviews carded ideas only)"
    save(os.path.join(out, "codex-pass.json"), {"candidates": list(cx.values())})

    # 3. Comparison
    ids = [c["id"] for c in cands]
    rows = compare(cl, cx, ids)
    save(os.path.join(out, "compare.json"), {"rows": rows})

    # 4a. Attacks, both at once
    tgt_for_claude = [render_entry(cx[i], False) for i in ids if cx[i]["status"] == "CHECKED"]
    tgt_for_codex = [render_entry(cl[i], True) for i in ids if cl[i]["status"] == "CHECKED"]
    att_cl, att_cx = {}, {}
    procs = []
    for name, targets in (("claude-attack", tgt_for_claude), ("codex-attack", tgt_for_codex)):
        if not targets:
            run.record(name, status="not needed", why="no CHECKED idea to attack", cost_usd=0); continue
        if not fits(run, name):
            continue
        if name == "claude-attack":
            b = min(CLAUDE_BUDGET[name], run.remaining())
            procs.append((name, start_claude(run, name, attack_prompt("claude", targets, window), ATTACK_SCHEMA, b), b))
            run.record(name, status="running", cost_usd=b)   # reserve while running, so the next check sees it
        else:
            procs.append((name, start_codex(run, name, attack_prompt("codex", targets, window)), None))
            run.record(name, status="running", cost_usd=CODEX_RESERVE[name])
    for name, p, b in procs:
        if name == "claude-attack":
            att_cl = by_id(finish_claude(run, name, p, "attacks", b), "attacks")
        else:
            att_cx = by_id(finish_codex(run, name, p, "attacks"), "attacks")
    save(os.path.join(out, "attacks.json"), {"claude_on_codex": list(att_cl.values()), "codex_on_claude": list(att_cx.values())})

    # 4b. Replies, both at once: each side concedes or defends once
    items_claude = [f"{render_entry(cl[i], False)}\nCodex's attack: {a.get('reason', '')} [{a.get('cite', '')}] (proposes {a.get('proposed_status', '')})"
                    for i, a in att_cx.items() if a.get("verdict") == "refuted" and i in cl]
    items_codex = [f"{render_entry(cx[i], False)}\nClaude's attack: {codex_safe(a.get('reason', ''))[0]} [{codex_safe(a.get('cite', ''))[0]}] (proposes {a.get('proposed_status', '')})"
                   for i, a in att_cl.items() if a.get("verdict") == "refuted" and i in cx]
    resp_cl, resp_cx = {}, {}
    procs = []
    for name, items in (("claude-respond", items_claude), ("codex-respond", items_codex)):
        if not items:
            run.record(name, status="not needed", why="nothing refuted to answer", cost_usd=0); continue
        if not fits(run, name):
            continue
        if name == "claude-respond":
            b = min(CLAUDE_BUDGET[name], run.remaining())
            procs.append((name, start_claude(run, name, respond_prompt("claude", items, window), RESPOND_SCHEMA, b), b))
            run.record(name, status="running", cost_usd=b)
        else:
            procs.append((name, start_codex(run, name, respond_prompt("codex", items, window)), None))
            run.record(name, status="running", cost_usd=CODEX_RESERVE[name])
    for name, p, b in procs:
        if name == "claude-respond":
            resp_cl = by_id(finish_claude(run, name, p, "responses", b), "responses")
        else:
            resp_cx = by_id(finish_codex(run, name, p, "responses"), "responses")
    save(os.path.join(out, "replies.json"), {"claude": list(resp_cl.values()), "codex": list(resp_cx.values())})

    return main_verdict(out)


def main_verdict(out):
    out = os.path.abspath(out)
    run = Run(out)
    d, cands = claude_candidates(out)
    cl = {c["id"]: c for c in cands}
    cx = {str(c["id"]): c for c in (load(os.path.join(out, "codex-pass.json"), {}) or {}).get("candidates", [])}
    cx = {i: cx.get(i) or {"id": i, "status": "NOT CHECKED YET", "reason": "no Codex pass", "evidence": []} for i in cl}
    att = load(os.path.join(out, "attacks.json"), {}) or {}
    rep = load(os.path.join(out, "replies.json"), {}) or {}
    ids = [c["id"] for c in cands]
    records = decide(ids, cl, cx, by_id({"a": att.get("claude_on_codex", [])}, "a"), by_id({"a": att.get("codex_on_claude", [])}, "a"),
                     by_id({"r": rep.get("codex", [])}, "r"), by_id({"r": rep.get("claude", [])}, "r"), run.steps)
    order = consensus(records)
    notes = []
    if run.spent() > CAP:
        notes.append(f"Spent ${run.spent():.2f}, over the ${CAP:.0f} cap: a Codex step can't be stopped mid-call, and its cost is known only after.")
    write_receipt(run, d, cands, records, order, notes)
    print(os.path.join(out, "builder.md"))
    return 0


def main_compare(out):
    out = os.path.abspath(out)
    d, cands = claude_candidates(out)
    cl = {c["id"]: c for c in cands}
    cx = {str(c["id"]): dict(c, status=norm_status(c.get("status"))) for c in (load(os.path.join(out, "codex-pass.json"), {}) or {}).get("candidates", [])}
    cx = {i: cx.get(i) or {"id": i, "status": "NOT CHECKED YET"} for i in cl}
    rows = compare(cl, cx, list(cl))
    save(os.path.join(out, "compare.json"), {"rows": rows})
    print(json.dumps(rows, indent=1))
    return 0


if __name__ == "__main__":
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__); sys.exit(0 if a else 64)
    if a[0] == "compare" and len(a) == 2:
        sys.exit(main_compare(a[1]))
    if a[0] == "verdict" and len(a) == 2:
        sys.exit(main_verdict(a[1]))
    if len(a) == 1:
        sys.exit(main_run(a[0]))
    print(__doc__, file=sys.stderr); sys.exit(64)
