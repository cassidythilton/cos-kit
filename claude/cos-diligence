def claude_candidates(out):
    d = load(os.path.join(out, "diligence.json"), {}) or {}
    cands = []
    for c in d.get("candidates", []) or []:
        if not isinstance(c, dict) or not c.get("id"):
            continue
        c = dict(c)
        c["id"] = str(c["id"])
        c["status"] = norm_status(c.get("status"))
        cands.append(c)
    return d, cands


def screen_into_ws(run, ws, window):
    """Copy what Codex may read into its workspace, each file through the canon tripwire. Returns a list for the prompt."""
    have = []
    sd = os.path.join(run.out, "slack-digest.md")
    if os.path.isfile(sd):
        t = open(sd, errors="replace").read()
        if CANON_RE.search(t):
            run.hold("slack-digest.md", "names a canon table")
        else:
            lines = t.splitlines()
            kept = [l if not TRANSCRIPT_RE.search(l) else "(line held on the Mac: it pointed at a call transcript)" for l in lines]
            if kept != lines:
                run.hold("slack-digest.md lines that pointed at a call", "transcripts never go to Codex")
            open(os.path.join(ws, "slack-digest.md"), "w").write("\n".join(kept) + "\n")
            have.append("slack-digest.md: Claude's summaries of this week's relevant Slack threads, with links (cite as slack-digest.md:N)")
    else:
        run.hold("slack-digest.md", "Claude's pass didn't write one, so Codex has no Slack")
    # Receipts (decision 1b): the board and roadmap as STEWARD saw them this week. receipt.json only, no artifacts.
    rdir = os.path.join(ws, "receipts"); os.makedirs(rdir, exist_ok=True)
    since = time.time() - 9 * 86400
    n = 0
    for job in sorted(os.listdir(os.path.join(COS, "outbox"))) if os.path.isdir(os.path.join(COS, "outbox")) else []:
        if not re.match(r"^(pulse|capture|reconcile|week|flow)-", job):
            continue
        rp = os.path.join(COS, "outbox", job, "receipt.json")
        if not os.path.isfile(rp) or os.path.getmtime(rp) < since:
            continue
        t = open(rp, errors="replace").read()
        if CANON_RE.search(t):
            run.hold(f"receipt {job}", "names a canon table"); continue
        open(os.path.join(rdir, job + ".json"), "w").write(t); n += 1
    if n:
        have.append(f"receipts/: {n} board and roadmap receipts from this week (pulse, capture, reconcile, week)")
    ex = os.path.join(COS, "handbook", "build-exclusions.md")
    if os.path.isfile(ex):
        t = open(ex, errors="replace").read()
        if CANON_RE.search(t):
            run.hold("build-exclusions.md", "names a canon table")
        else:
            open(os.path.join(ws, "build-exclusions.md"), "w").write(t)
            have.append("build-exclusions.md: work Cassidy ruled out (a candidate it covers is DEAD)")
    return have


