def pass_by_id(obj, cands, model):
    got = {str(c.get("id")): c for c in (obj or {}).get("candidates", []) if isinstance(c, dict)}
    res = {}
    for c in cands:
        g = got.get(c["id"])
        if g is None:
            res[c["id"]] = {"id": c["id"], "status": "NOT CHECKED YET", "reason": f"{model} gave no answer for it", "evidence": [], "rank": None}
        else:
            g = dict(g); g["status"] = norm_status(g.get("status")); g["id"] = c["id"]
            res[c["id"]] = g
    return res


# ------------------------------------------------------------------ comparison (no model)
def compare(cl, cx, ids):
    rows = []
    for i in ids:
        a, b = cl[i]["status"], cx[i]["status"]
        if a == "CHECKED" and b == "CHECKED":
            cat = "agree CHECKED"
        elif a == "CHECKED" or b == "CHECKED":
            cat = "disagree"
        else:
            cat = "agree DEAD" if a == b == "DEAD" else "agree out"
        rows.append({"id": i, "claude": a, "codex": b, "category": cat})
    return rows


