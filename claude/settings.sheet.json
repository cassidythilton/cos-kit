{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "mcp__claude_ai_Google_Sheets__get_values",
      "mcp__claude_ai_Google_Sheets__update_values"
    ],
    "deny": [
      "Bash",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Task"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/cos/claude/gate.sh"
          }
        ]
      }
    ]
  }
}
