def cmd_kinds(args):
    b = load_budget()
    for k, v in KINDS.items():
        u, m = cap(b, k)
        print("%-20s %-6s %-11s up to %s, %s  %s" % (k, v[1], v[2], money(u), mins(m), v[0]))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    fn = {"add": cmd_add, "propose": cmd_propose, "approve": cmd_approve, "run": cmd_run, "report": cmd_report,
          "status": cmd_status, "kinds": cmd_kinds}.get(cmd)
    if not fn:
        die("unknown command: %s (add, propose, approve, run, report, status, kinds)" % cmd)
    return fn(args) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
