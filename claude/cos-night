        print("Tonight's plan: not proposed yet.")
    ln = last_night(t)
    lr = [r for r in runs if r.get("night") == ln]
    print("Last night (%s): %d jobs, %s, %s." % (ln, len(lr), money(sum(float(r.get("cost_usd") or 0) for r in lr)),
