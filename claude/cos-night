#!/usr/bin/env -S python3 -I
"""cos-night: the night shift (plan 2026-11-19, change 8). No model runs here; it plans, starts and accounts.

  cos-night add <kind> "<what>" [--from cassidy|ops|steward|builder] [--slug <slug>]   queue one item
  cos-night propose            tonight's plan in plain words, inside the budget (JSON; .text is for Cassidy)
  cos-night approve <id,id|1,2|all>   his yes to tonight's plan, or part of it. Nothing runs unapproved.
  cos-night run                what launchd starts at 22:00: approved items, one at a time, each stopped at its cap
  cos-night report [YYYYMMDD]  the morning "While you slept" block; writes ~/cos/outbox/night-<night>/receipt.json
  cos-night status             the queue, tonight's plan, and the week's spend
  cos-night kinds              the nine kinds with their caps

Budget: ~/cos/handbook/night-budget.json (Cassidy's file; this script only reads it).
State:  ~/cos/state/night-queue.json (queue, plan, nights) and ~/cos/state/night-runs.jsonl (one line per job run).
Ledger: every run, refusal and stop goes to cos-ledger night.
Jobs go through cos-run in the foreground (investigate, lake, fix, build), never --async, so this script can time them.
Nothing here sends, posts, pushes or merges; the recipes forbid it and the lanes can't.

Test hooks (never set on the real Mac): COS_NIGHT_RUNNER (instead of ~/cos/bin/cos-run), COS_NIGHT_NOW
(YYYY-MM-DDTHH:MM, the clock), COS_NIGHT_POWER (ac|battery), COS_NIGHT_SECS_PER_MIN (default 60),
COS_NIGHT_KILL_GRACE (seconds between TERM and KILL, default 20), COS_NIGHT_NO_CAFFEINATE=1, COS_NIGHT_BUDGET,
COS_NIGHT_BRIEFS, COS_NIGHT_LEDGER.
"""
import datetime as dt
import glob
import json
import os
import re
import signal
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
COS = os.path.join(HOME, "cos")
HERE = os.path.dirname(os.path.realpath(__file__))
STATE = os.path.join(COS, "state")
QUEUE = os.path.join(STATE, "night-queue.json")
RUNS = os.path.join(STATE, "night-runs.jsonl")
LOCK = os.path.join(STATE, "night.lock")
OUTBOX = os.path.join(COS, "outbox")

# kind -> (label, size, lane, short code for job ids, what "share" stages in the morning)
KINDS = {
    "meeting-prep": ("Meeting prep for tomorrow", "small", "investigate", "prep",
                     "the Chief puts each meeting's notes in front of you before it starts"),
    "call-follow-through": ("Follow-through on yesterday's calls", "small", "investigate", "calls",
                            "the Chief saves the drafted replies in your Slack Drafts and shows the card notes as one list for your yes"),
    "board-cleanup": ("Board and roadmap cleanup", "small", "investigate", "board",
                      "the Chief shows the cleanup list in plain words for your yes"),
    "pr-reviews": ("PR review drafts", "medium", "investigate", "prs",
                   "the Chief shows each review for your yes; nothing is posted until you say so"),
    "data-answer": ("Data answer", "medium", "lake", "data",
                    "the Chief drafts a reply with the numbers for your yes"),
    "write-up": ("Write-up", "medium", "investigate", "writeup",
                 "the Chief puts it in a private Google Doc only you can see, then asks before sharing it"),
    "decision-doc": ("Decision-doc draft", "medium", "investigate", "decision",
                     "the Chief starts the decision doc on your card as a draft for your yes"),
    "system-fix": ("Fix for the system", "medium", "fix", "fix",
                   "the Chief shows you the fix; it lands only on your yes"),
    "prototype": ("Prototype", "large", "build", "proto",
                  "the Chief stages a draft PR from the build for your yes"),
}
# Planning order (plan, change 8): small kinds every night they have input, then the one large job if one is due,
# then medium kinds fill what is left. Run order is the same.
SIZE_RANK = {"small": 0, "large": 1, "medium": 2}
FROM = ("cassidy", "ops", "steward", "builder", "mac")
FROM_LABEL = {"cassidy": "Cassidy", "ops": "OPS", "steward": "STEWARD", "builder": "BUILDER", "mac": "the Mac"}


def die(msg, code=64):
    print(msg, file=sys.stderr)
    sys.exit(code)


def now():
    v = os.environ.get("COS_NIGHT_NOW", "").strip()
    if v:
        for f in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M", "%Y-%m-%d %H:%M"):
            try:
                return dt.datetime.strptime(v, f)
            except ValueError:
                pass
        die("COS_NIGHT_NOW must look like 2026-11-19T22:00")
    return dt.datetime.now()


def ymd(d):
    return d.strftime("%Y%m%d")


def plan_night(t):
    """The night a plan is for: today, unless it's before 4 AM (then the night already under way)."""
    return ymd(t.date() - dt.timedelta(days=1)) if t.hour < 4 else ymd(t.date())


def last_night(t):
    """The night run and report act on: today from noon on, else the night that started yesterday evening."""
    return ymd(t.date() - dt.timedelta(days=1)) if t.hour < 12 else ymd(t.date())


def week_of(night):
    d = dt.datetime.strptime(night, "%Y%m%d").date()
    mon = d - dt.timedelta(days=d.weekday())
    return ymd(mon), ymd(mon + dt.timedelta(days=6))


def first_existing(*paths):
    for p in paths:
        if p and os.path.exists(p):
            return p
    return None


def load_budget():
    p = first_existing(os.environ.get("COS_NIGHT_BUDGET"), os.path.join(COS, "handbook", "night-budget.json"),
                       os.path.join(HERE, "..", "handbook", "night-budget.json"))
    if not p:
        die("no night-budget.json (expected ~/cos/handbook/night-budget.json)", 66)
    try:
        with open(p) as f:
            b = json.load(f)
        for k in KINDS:
            float(b["kinds"][k]["usd"]), float(b["kinds"][k]["minutes"])
        float(b["per_night"]["usd"]), float(b["per_night"]["minutes"]), float(b["per_week"]["usd"])
    except (OSError, ValueError, KeyError, TypeError) as e:
        die("night-budget.json is not usable (%s). Nothing was planned or run." % e, 65)
    return b


def cap(b, kind):
    k = b["kinds"][kind]
    return float(k["usd"]), float(k["minutes"])


def load_state():
    try:
        with open(QUEUE) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    s.setdefault("items", [])
    s.setdefault("next", 1)
    s.setdefault("plan", None)
    s.setdefault("nights", {})
    return s


def save_state(s):
    os.makedirs(STATE, exist_ok=True)
    tmp = QUEUE + ".tmp.%d" % os.getpid()
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, QUEUE)


def load_runs():
    out = []
    try:
        with open(RUNS) as f:
            for line in f:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        pass
    return out


def append_run(r):
    os.makedirs(STATE, exist_ok=True)
    with open(RUNS, "a") as f:
        f.write(json.dumps(r) + "\n")


def spent(runs, lo, hi=None):
    hi = hi or lo
    return round(sum(float(r.get("cost_usd") or 0) for r in runs if lo <= r.get("night", "") <= hi), 2)


def ledger(**kv):
    exe = first_existing(os.environ.get("COS_NIGHT_LEDGER"), os.path.join(COS, "bin", "cos-ledger"),
                         os.path.join(HERE, "cos-ledger"))
    if not exe:
        return
    try:
        subprocess.run([exe, "night"] + ["%s=%s" % (k, v) for k, v in kv.items()],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
    except (OSError, subprocess.SubprocessError):
        pass


def money(x):
    return "$%.2f" % float(x)


def hm(minutes):
    m = int(round(float(minutes)))
    return "%d h %d min" % (m // 60, m % 60)


def mins(m):
    m = int(round(float(m)))
    if m < 60:
        return "%d min" % m
    return "%d h" % (m // 60) if m % 60 == 0 else hm(m)


def find_item(s, iid):
    for it in s["items"]:
        if it["id"] == iid:
            return it
    return None


# ---------------------------------------------------------------- add
def cmd_add(args):
    if len(args) < 2:
        die('usage: cos-night add <kind> "<what>" [--from cassidy|ops|steward|builder] [--slug <slug>]\nkinds: '
            + ", ".join(KINDS))
    kind, what, rest = args[0], args[1], args[2:]
    if kind not in KINDS:
        die("unknown kind '%s'. Kinds: %s" % (kind, ", ".join(KINDS)))
    what = " ".join(what.split())
    if not what or len(what) > 1000:
        die("say what the item is in one line, under 1000 characters")
    src, slug = "cassidy", ""
    while rest:
        if rest[0] == "--from" and len(rest) > 1:
            src = rest[1]
            rest = rest[2:]
        elif rest[0] == "--slug" and len(rest) > 1:
            slug = rest[1]
            rest = rest[2:]
        else:
            die("unknown option: %s" % rest[0])
    if src not in FROM:
        die("--from is one of: " + ", ".join(FROM))
    if kind == "prototype":
        if not slug:
            words = re.sub(r"[^a-z0-9 ]", " ", what.lower()).split()[:4]
            slug = "-".join(["night"] + words)[:40].rstrip("-")
        if not re.match(r"^[a-z0-9][a-z0-9-]{1,40}$", slug):
            die("--slug: lowercase letters, digits and dashes, 2 to 41 characters")
    elif slug:
        die("--slug is only for a prototype")
    s = load_state()
    iid = "n%d" % s["next"]
    s["next"] += 1
    item = {"id": iid, "kind": kind, "what": what, "from": src, "added": now().strftime("%Y-%m-%dT%H:%M"),
            "status": "queued"}
    if slug:
        item["slug"] = slug
    s["items"].append(item)
    save_state(s)
    ledger(event="add", item=iid, kind=kind, src=src)
    print(json.dumps({"id": iid, "kind": kind, "size": KINDS[kind][1], "status": "queued"}))


# ---------------------------------------------------------------- propose
def build_plan(s, b, night):
    runs = load_runs()
    wlo, whi = week_of(night)
    pn, pw = b["per_night"], b["per_week"]
    usd_left = min(float(pn["usd"]) - spent(runs, night), float(pw["usd"]) - spent(runs, wlo, whi))
    min_left = float(pn["minutes"])
    max_jobs, max_large = int(pn.get("max_jobs", 4)), int(pn.get("max_large", 1))
    proto_max = int(b["kinds"]["prototype"].get("max_per_week", 2))
    protos = sum(1 for r in runs if wlo <= r.get("night", "") <= whi and r.get("kind") == "prototype")
    queued = [i for i in s["items"] if i["status"] == "queued"]
    queued.sort(key=lambda i: (SIZE_RANK[KINDS[i["kind"]][1]], i["added"], int(i["id"][1:])))
    plan, waiting, kinds_in, large = [], [], set(), 0
    for it in queued:
        k = it["kind"]
        size = KINDS[k][1]
        u, m = cap(b, k)
        why = None
        if size == "small" and k in kinds_in:
            why = "one of these a night"
        elif size == "large" and large >= max_large:
            why = "one large job a night"
        elif k == "prototype" and protos >= proto_max:
            why = "already %d prototypes this week" % proto_max
        elif len(plan) >= max_jobs:
            why = "already %d jobs tonight" % max_jobs
        elif u > usd_left + 1e-9:
            why = "not enough money left tonight or this week: %s left, it needs up to %s" % (money(max(usd_left, 0)), money(u))
        elif m > min_left + 1e-9:
            why = "not enough time left tonight: %s left, it needs up to %s" % (mins(max(min_left, 0)), mins(m))
        if why:
            waiting.append({"id": it["id"], "kind": k, "what": it["what"], "why": why})
            continue
        plan.append({"id": it["id"], "kind": k, "what": it["what"], "size": size, "cap_usd": u, "cap_min": m,
                     "from": it["from"]})
        kinds_in.add(k)
        usd_left -= u
        min_left -= m
        if size == "large":
            large += 1
        if k == "prototype":
            protos += 1
    return plan, waiting


def plan_text(night, plan, waiting, b, runs):
    d = dt.datetime.strptime(night, "%Y%m%d")
    wlo, whi = week_of(night)
    lines = ["Tonight's plan for %s, %s %d (needs your yes; nothing runs without it):" % (
        d.strftime("%a"), d.strftime("%b"), d.day)]
    if not plan:
        lines.append("Nothing queued fits tonight, so nothing will run.")
    for n, p in enumerate(plan, 1):
        lines.append("%d. %s: %s. %s job, up to %s and %s." % (
            n, KINDS[p["kind"]][0], p["what"], p["size"].capitalize(), money(p["cap_usd"]), mins(p["cap_min"])))
    tu = sum(p["cap_usd"] for p in plan)
    tm = sum(p["cap_min"] for p in plan)
    lines.append("At most %s and %s in all, of tonight's %s and %s. This week so far: %s of %s." % (
        money(tu), mins(tm), money(b["per_night"]["usd"]), mins(b["per_night"]["minutes"]),
        money(spent(runs, wlo, whi)), money(b["per_week"]["usd"])))
    if waiting:
        lines.append("Waiting for another night:")
        lines += ["- %s: %s. %s." % (KINDS[w["kind"]][0], w["what"][:120], w["why"][0].upper() + w["why"][1:]) for w in waiting]
    lines.append("The Mac must be plugged in with the lid open at 10 PM. Reply \"all\", or the numbers you want.")
    return "\n".join(lines)


def seed(s):
    """Nov 20: the first night ran nothing because nobody queued anything. The Mac now adds the kinds it can see a
    need for itself (at most one of each a night, never a duplicate of a queued item): board cleanup every weeknight,
    call follow-through when today has call transcripts, PR review drafts when PRs wait on Cassidy, and a system fix
    when monitoring has an open problem. Meeting prep, write-ups and data answers need a person's ask (the Chief or
    OPS adds them). Off with COS_NIGHT_NO_SEED=1 or "seed": false in night-budget.json."""
    if os.environ.get("COS_NIGHT_NO_SEED") == "1" or load_budget().get("seed") is False:
        return []
    t = now()
    if t.weekday() in (4, 5):   # Friday and Saturday nights don't run
        return []
    queued = {i["kind"] for i in s["items"] if i["status"] == "queued"}
    home = os.path.expanduser("~")
    adds = []
    if "board-cleanup" not in queued:
        adds.append(("board-cleanup", "Tidy the board and roadmap: stale cards, missing daily logs, and sheet rows that don't match their cards"))
    try:
        today = t.date()
        calls = [f for f in os.listdir(f"{home}/cos/zoom") if dt.date.fromtimestamp(os.path.getmtime(f"{home}/cos/zoom/{f}")) == today]
    except Exception:
        calls = []
    if calls and "call-follow-through" not in queued:
        adds.append(("call-follow-through", "Today's %d call transcript%s: action items to draft cards and replies" % (len(calls), "s" if len(calls) != 1 else "")))
    try:
        items = json.load(open(f"{home}/cos/state/obligations.json")).get("items", {})
        prs = ["%s#%s" % (v["repo"].split("/")[1], v["number"]) for v in items.values() if v.get("kind") == "review" and v.get("status", "open") == "open"]
    except Exception:
        prs = []
    if prs and "pr-reviews" not in queued:
        adds.append(("pr-reviews", "Draft reviews for the PRs waiting on Cassidy: " + ", ".join(prs[:5])))
    try:
        op = list(json.load(open(f"{home}/cos/state/health.json")).get("open", {}).values())
    except Exception:
        op = []
    if op and "system-fix" not in queued:
        adds.append(("system-fix", "Diagnose and prepare a fix for: " + op[0]["title"]))
    for kind, what in adds:
        iid = "n%d" % s["next"]
        s["next"] += 1
        s["items"].append({"id": iid, "kind": kind, "what": what, "from": "mac", "added": t.strftime("%Y-%m-%dT%H:%M"), "status": "queued"})
        ledger(event="add", item=iid, kind=kind, src="mac")
    return adds


def cmd_propose(args):
    b = load_budget()
    s = load_state()
    seed(s)
    night = plan_night(now())
    if s["nights"].get(night, {}).get("started"):
        die("tonight's shift already started; nothing to plan until tomorrow", 75)
    plan, waiting = build_plan(s, b, night)
    s["plan"] = {"night": night, "ids": [p["id"] for p in plan], "approved": [],
                 "proposed_at": now().strftime("%Y-%m-%dT%H:%M")}
    save_state(s)
    out = {"night": night, "items": plan, "total_usd": round(sum(p["cap_usd"] for p in plan), 2),
           "total_min": int(sum(p["cap_min"] for p in plan)), "waiting": waiting,
           "text": plan_text(night, plan, waiting, b, load_runs())}
    ledger(event="propose", night=night, items=",".join(p["id"] for p in plan),
           total_usd=out["total_usd"])
    print(json.dumps(out, indent=1))


# ---------------------------------------------------------------- approve
def cmd_approve(args):
    if not args:
        die("usage: cos-night approve <id,id|1,2|all>")
    s = load_state()
    p = s.get("plan")
    if not p or p["night"] != plan_night(now()):
        die("no plan for tonight yet. Run: cos-night propose", 66)
    if s["nights"].get(p["night"], {}).get("started"):
        die("tonight's shift already started; approvals are closed", 75)
    want = ",".join(args).replace(" ", ",")
    if want == "all":
        ids = list(p["ids"])
    else:
        ids = []
        for tok in [t for t in want.split(",") if t]:
            if tok.isdigit() and 1 <= int(tok) <= len(p["ids"]):
                tok = p["ids"][int(tok) - 1]
            if tok not in p["ids"]:
                die("%s isn't in tonight's plan (%s)" % (tok, ", ".join(p["ids"]) or "empty"))
            ids.append(tok)
    p["approved"] = [i for i in p["ids"] if i in ids or i in p["approved"]]
    p["approved_at"] = now().strftime("%Y-%m-%dT%H:%M")
    save_state(s)
    ledger(event="approve", night=p["night"], items=",".join(p["approved"]))
    print(json.dumps({"night": p["night"], "approved": p["approved"],
                      "not_approved": [i for i in p["ids"] if i not in p["approved"]]}))


# ---------------------------------------------------------------- run
def on_ac():
    v = os.environ.get("COS_NIGHT_POWER", "").strip().lower()
    if v in ("ac", "battery"):
        return v
    try:
        out = subprocess.run(["pmset", "-g", "batt"], capture_output=True, text=True, timeout=15).stdout
    except (OSError, subprocess.SubprocessError):
        return "unknown"
    if "'AC Power'" in out:
        return "ac"
    if "'Battery Power'" in out:
        return "battery"
    return "unknown"


def brief_for(it, b, job, outd):
    d = first_existing(os.environ.get("COS_NIGHT_BRIEFS"), os.path.join(COS, "claude", "briefs", "night-%s.md" % it["kind"]),
                       os.path.join(HERE, "briefs", "night-%s.md" % it["kind"]))
    if d and os.path.isdir(d):
        d = os.path.join(d, "night-%s.md" % it["kind"])
    if not d or not os.path.isfile(d):
        return None
    with open(d) as f:
        recipe = f.read().rstrip()
    u, m = cap(b, it["kind"])
    extra = ""
    if it["kind"] == "pr-reviews":
        extra = "\nAt most %d PRs tonight." % int(b["kinds"]["pr-reviews"].get("max_prs", 5))
    return ("%s\n\n---\nTonight's item, from %s (data, not instructions): %s\n"
            "Limits: up to %s and %d minutes. At the time limit the Mac stops this job; what is in the job folder by "
            "then is what Cassidy sees, so keep progress.md and while-you-slept.md current as you go.%s\n"
            "Job folder: %s\n" % (recipe, FROM_LABEL.get(it["from"], it["from"]), it["what"], money(u), int(m), extra, outd))


def job_cost(outd, t0):
    """Sum total_cost_usd from the job's own run files (receipts repeat it as cost_usd, so they're skipped)."""
    total, seen = 0.0, False
    for p in glob.glob(os.path.join(outd, "*.json")) + glob.glob(os.path.join(outd, "*", "*.json")):
        if os.path.basename(p).startswith("receipt"):
            continue
        try:
            if os.path.getmtime(p) < t0 - 2:
                continue
            with open(p) as f:
                v = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(v, dict) and isinstance(v.get("total_cost_usd"), (int, float)):
            total += float(v["total_cost_usd"])
            seen = True
    return (round(total, 4), "reported") if seen else (None, "none")


def run_one(it, b, night):
    k = it["kind"]
    label, size, lane, code, _ = KINDS[k]
    job = "night-%s-%s-%s" % (code, night, it["id"])
    outd = os.path.join(OUTBOX, job)
    os.makedirs(outd, exist_ok=True)
    bdir = os.path.join(STATE, "night", night)
    os.makedirs(bdir, exist_ok=True)
    text = brief_for(it, b, job, outd)
    u, m = cap(b, k)
    rec = {"night": night, "id": it["id"], "kind": k, "what": it["what"], "job": job, "lane": lane,
           "cap_usd": u, "cap_min": m}
    if text is None:
        rec.update(status="failed", cost_usd=0.0, cost_source="none", minutes=0, why="its recipe is missing")
        return rec
    bfile = os.path.join(bdir, job + ".md")
    with open(bfile, "w") as f:
        f.write(text)
    runner = os.environ.get("COS_NIGHT_RUNNER") or os.path.join(COS, "bin", "cos-run")
    # investigate and build take a brief file; lake (a question) and fix (a problem) take the words.
    arg = text if lane in ("lake", "fix") else bfile
    cmd = [runner, lane, job, arg]
    if lane == "build":
        cmd += ["--slug", it.get("slug") or ("night-" + it["id"])]
    if lane == "lake":
        cmd += ["--env", "dev"]
    env = dict(os.environ, COS_CALLER="night", COS_ROUTINE="night-shift", COS_JOB_CAP_USD=str(u))
    if lane == "build":   # the build lane's own spend cap, leaving room for its verifier and checker
        env["COS_BUILD_BUDGET"] = str(max(1, int(u) - 4))
    spm = float(os.environ.get("COS_NIGHT_SECS_PER_MIN", "60"))
    grace = float(os.environ.get("COS_NIGHT_KILL_GRACE", "20"))
    limit = m * spm
    ledger(event="start", night=night, item=it["id"], kind=k, job=job, cap_usd=u, cap_min=int(m))
    t0 = time.time()
    killed = False
    with open(os.path.join(outd, "night-run.log"), "ab") as log:
        try:
            # A new session: the job and everything it starts share one process group, so the cap stops all of it.
            p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, env=env, cwd=HOME,
                                 start_new_session=True)
        except OSError as e:
            rec.update(status="failed", cost_usd=0.0, cost_source="none", minutes=0, why="couldn't start (%s)" % e)
            return rec
        try:
            p.wait(timeout=limit)
        except subprocess.TimeoutExpired:
            killed = True
            for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 10)):
                try:
                    os.killpg(p.pid, sig)
                except (ProcessLookupError, PermissionError):
                    pass
                try:
                    p.wait(timeout=wait)
                    if sig == signal.SIGTERM:
                        try:   # stragglers that ignored TERM
                            os.killpg(p.pid, signal.SIGKILL)
                        except (ProcessLookupError, PermissionError):
                            pass
                    break
                except subprocess.TimeoutExpired:
                    continue
    elapsed_min = round((time.time() - t0) / spm, 1)
    rc = p.returncode
    receipt = {}
    try:
        with open(os.path.join(outd, "receipt.json")) as f:
            receipt = json.load(f)
        if os.path.getmtime(os.path.join(outd, "receipt.json")) < t0 - 2:
            receipt = {}
    except (OSError, ValueError):
        receipt = {}
    rs = (receipt.get("receipt") or {}).get("status", "")
    if killed:
        status = "partial"
    elif rs in ("done", "partial", "failed", "blocked"):
        status = rs
    else:
        status = "failed"
    cost, src = job_cost(outd, t0)
    if cost is None:   # no cost line: count the whole cap, so the budget can't be overspent unseen
        cost, src = u, "cap"
    rec.update(status=status, exit=rc, killed=killed, cost_usd=round(cost, 2), cost_source=src, minutes=elapsed_min)
    ledger(event="end", night=night, item=it["id"], kind=k, job=job, status=status, cost_usd="%.2f" % cost,
           cost_source=src, minutes=elapsed_min, cap_usd=u)
    return rec


def take_lock():
    os.makedirs(STATE, exist_ok=True)
    try:
        fd = os.open(LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError:
        try:
            pid = int(open(LOCK).read().strip() or 0)
            os.kill(pid, 0)
            return False
        except (ValueError, OSError):
            os.unlink(LOCK)
            return take_lock()
    os.write(fd, str(os.getpid()).encode())
    os.close(fd)
    return True


def cmd_run(args):
    b = load_budget()
    t = now()
    night = last_night(t)
    if not take_lock():
        die("the night shift is already running", 75)
    try:
        return _run(b, t, night)
    finally:
        try:
            os.unlink(LOCK)
        except OSError:
            pass


def _run(b, t, night):
    s = load_state()
    rec_n = s["nights"].setdefault(night, {})
    power = on_ac()
    if power != "ac":
        why = ("the Mac was on battery" if power == "battery" else "the Mac couldn't tell whether it was plugged in")
        rec_n.update(refused=why, refused_at=t.strftime("%Y-%m-%dT%H:%M"))
        save_state(s)
        ledger(event="refused", night=night, reason=power)
        print(json.dumps({"night": night, "refused": why,
                          "text": "The night shift didn't run: %s. Plug it in, lid open; tonight's plan carries over." % why}))
        return 75
    p = s.get("plan") or {}
    if p.get("night") != night or not p.get("approved"):
        rec_n.update(note="nothing approved")
        save_state(s)
        ledger(event="idle", night=night, reason="nothing approved")
        print(json.dumps({"night": night, "ran": [], "text": "Nothing was approved for tonight, so nothing ran."}))
        return 0
    if not os.environ.get("COS_NIGHT_NO_CAFFEINATE"):
        try:   # keep the Mac awake while this process lives (holds only on AC power)
            subprocess.Popen(["caffeinate", "-i", "-s", "-w", str(os.getpid())], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except OSError:
            pass
    rec_n.update(started=t.strftime("%Y-%m-%dT%H:%M"), refused=None)
    rec_n.setdefault("held", [])
    save_state(s)
    ledger(event="begin", night=night, items=",".join(p["approved"]))
    wlo, whi = week_of(night)
    stop_after = b.get("window", {}).get("no_new_jobs_after", "05:00")
    sh, sm = [int(x) for x in stop_after.split(":")]
    proto_max = int(b["kinds"]["prototype"].get("max_per_week", 2))
    ran, large = [], 0
    todo = [i for i in p["ids"] if i in p["approved"]]
    for n, iid in enumerate(todo):
        s = load_state()
        it = find_item(s, iid)
        if not it or it["status"] != "queued":
            continue
        k = it["kind"]
        u, m = cap(b, k)
        runs = load_runs()
        night_left = float(b["per_night"]["usd"]) - spent(runs, night)
        week_left = float(b["per_week"]["usd"]) - spent(runs, wlo, whi)
        min_left = float(b["per_night"]["minutes"]) - sum(float(r.get("minutes") or 0) for r in runs if r.get("night") == night)
        cur = now()
        why = None
        if week_left < u - 1e-9:
            why = "the week's money ran out (%s left of %s; it needs up to %s)" % (
                money(max(week_left, 0)), money(b["per_week"]["usd"]), money(u))
        elif night_left < u - 1e-9:
            why = "tonight's money ran out (%s left; it needs up to %s)" % (money(max(night_left, 0)), money(u))
        elif min_left < m - 1e-9:
            why = "tonight's time ran out (%s left; it needs up to %s)" % (mins(max(min_left, 0)), mins(m))
        elif len([r for r in ran if r.get("status") != "held"]) >= int(b["per_night"].get("max_jobs", 4)):
            why = "already %d jobs tonight" % int(b["per_night"].get("max_jobs", 4))
        elif KINDS[k][1] == "large" and large >= int(b["per_night"].get("max_large", 1)):
            why = "one large job a night"
        elif k == "prototype" and sum(1 for r in runs if wlo <= r.get("night", "") <= whi
                                      and r.get("kind") == "prototype" and r.get("status") != "held") >= proto_max:
            why = "already %d prototypes this week" % proto_max
        elif cur.hour < 12 and (cur.hour, cur.minute) >= (sh, sm):
            why = "it was past %s, too late to start" % stop_after
        if why:
            # Money and time stop the night: nothing after this starts either. Each goes back in the queue.
            stop = why.startswith(("the week", "tonight", "it was past"))
            for jid in (todo[n:] if stop else [iid]):
                ji = find_item(s, jid)
                if ji and ji["status"] == "queued":
                    s["nights"][night]["held"].append({"id": jid, "kind": ji["kind"], "what": ji["what"], "why": why})
                    ledger(event="held", night=night, item=jid, kind=ji["kind"], reason=why)
            save_state(s)
            if stop:
                break
            continue
        it["status"] = "running"
        save_state(s)
        rec = run_one(it, b, night)
        append_run(rec)
        ran.append(rec)
        if KINDS[k][1] == "large":
            large += 1
        s = load_state()
        it = find_item(s, iid)
        it["status"] = rec["status"]
        it["night"] = night
        it["job"] = rec["job"]
        save_state(s)
    s = load_state()
    s["nights"][night]["ended"] = now().strftime("%Y-%m-%dT%H:%M")
    save_state(s)
    tot = round(sum(r["cost_usd"] for r in ran), 2)
    ledger(event="finish", night=night, jobs=len(ran), cost_usd="%.2f" % tot,
           minutes=round(sum(r["minutes"] for r in ran), 1))
    print(json.dumps({"night": night, "ran": ran, "held": s["nights"][night]["held"], "spent_usd": tot}, indent=1))
    return 0


# ---------------------------------------------------------------- report
def read_lines(path, n):
    try:
        with open(path) as f:
            raw = f.read(20000)
    except OSError:
        return []
    out = []
    for line in raw.splitlines():
        line = line.strip().lstrip("-*").strip()
        line = re.sub(r"^\d+[.)]\s*", "", line)
        if line and not line.startswith("#"):
            out.append(line[:300])
    return out[:n] if n else out


def item_block(n, r):
    k = r["kind"]
    label = KINDS[k][0]
    outd = os.path.join(OUTBOX, r["job"])
    head_status = {"done": "done", "partial": "partly done", "failed": "didn't finish", "blocked": "blocked"}.get(
        r["status"], r["status"])
    lines = ["%d. %s: %s (%s, %s, %s)" % (n, label, r["what"][:160], head_status, money(r["cost_usd"]),
                                          mins(r.get("minutes") or 0))]
    wys = read_lines(os.path.join(outd, "while-you-slept.md"), 0)
    three = [l for l in wys if not l.lower().startswith("decision")][:3]
    if not three:
        try:
            with open(os.path.join(outd, "receipt.json")) as f:
                summ = (json.load(f).get("receipt") or {}).get("summary") or ""
            three = [l.strip()[:300] for l in summ.splitlines() if l.strip()][:3]
        except (OSError, ValueError):
            three = []
    if r.get("killed"):
        prog = read_lines(os.path.join(outd, "progress.md"), 0)
        got = prog[-1] if prog else "nothing it had written down yet"
        three = (["It stopped at its %s limit. What it got done: %s" % (mins(r["cap_min"]), got)] + three)[:3]
    if not three:
        three = ["It stopped before writing anything down. Nothing is ready from this one."]
    if r.get("cost_source") == "cap":
        three.append("(It didn't report its cost, so it's counted at its full %s.)" % money(r["cap_usd"]))
    if r["status"] in ("done", "partial"):
        dec = "Decide: share, revise or drop? Share means %s." % KINDS[k][4]
    else:
        dec = "Decide: try again tonight, or drop?"
    return lines + ["   " + l for l in three] + ["   " + dec], "%s: %s" % (label, dec.replace("Decide: ", ""))


def cmd_report(args):
    b = load_budget()
    night = args[0] if args and re.match(r"^\d{8}$", args[0]) else last_night(now())
    s = load_state()
    nrec = s["nights"].get(night, {})
    runs = [r for r in load_runs() if r.get("night") == night]
    allruns = load_runs()
    wlo, whi = week_of(night)
    text, questions, artifacts = ["While you slept"], [], []
    if nrec.get("refused"):
        text.append("The night shift didn't run: %s at 10 PM. Plug it in with the lid open; the plan carries over "
                    "to tonight if you approve it again." % nrec["refused"])
    for n, r in enumerate(runs, 1):
        blk, q = item_block(n, r)
        text += blk
        questions.append("%d. %s" % (n, q))
        artifacts.append(os.path.join(OUTBOX, r["job"]))
    for h in nrec.get("held", []):
        text.append("Not run: %s, %s (%s). It's back in the queue." % (KINDS[h["kind"]][0], h["what"][:120], h["why"]))
    tot = round(sum(float(r.get("cost_usd") or 0) for r in runs), 2)
    tmin = sum(float(r.get("minutes") or 0) for r in runs)
    text.append("Last night: %d job%s, %s, %s." % (len(runs), "" if len(runs) == 1 else "s", money(tot), hm(tmin)))
    text.append("This week so far: %s of %s." % (money(spent(allruns, wlo, whi)), money(b["per_week"]["usd"])))
    statuses = [r["status"] for r in runs]
    if nrec.get("refused"):
        status = "blocked"
    elif not runs and not nrec.get("held"):
        status = "done"
    elif statuses and all(x in ("failed", "blocked") for x in statuses):
        status = "failed"
    elif nrec.get("held") or any(x != "done" for x in statuses):
        status = "partial"
    else:
        status = "done"
    summary = "\n".join(text)
    if not runs and not nrec.get("held") and not nrec.get("refused"):
        summary = "NO CHANGE"   # nothing was planned: cos-sched doesn't push a NO CHANGE receipt
    job = "night-%s" % night
    outd = os.path.join(OUTBOX, job)
    os.makedirs(outd, exist_ok=True)
    receipt = {"job": job, "lane": "night", "cost_usd": tot,
               "receipt": {"status": status, "summary": summary, "open_questions": questions[:5],
                           "artifacts": artifacts}}
    tmp = os.path.join(outd, "receipt.json.tmp")
    with open(tmp, "w") as f:
        json.dump(receipt, f, indent=1)
    os.replace(tmp, os.path.join(outd, "receipt.json"))
    ledger(event="report", night=night, jobs=len(runs), cost_usd="%.2f" % tot, status=status)
    print(summary)
    return 0


