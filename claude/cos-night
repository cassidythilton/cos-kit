    b = load_budget()
    s = load_state()
    t = now()
    runs = load_runs()
    pn = plan_night(t)
    wlo, whi = week_of(pn)
    q = [i for i in s["items"] if i["status"] == "queued"]
    print("Queue: %d waiting." % len(q))
    for i in q:
        print("  %s  %s: %s (from %s)" % (i["id"], KINDS[i["kind"]][0], i["what"][:100], FROM_LABEL[i["from"]]))
